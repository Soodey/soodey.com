{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soodey-com",
  "compatibility_date": "2026-05-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "soodey.com",
      "custom_domain": true
    },
    {
      "pattern": "www.soodey.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
