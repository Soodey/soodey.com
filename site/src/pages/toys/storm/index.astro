---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Villain Storm Studio // SOODEY"
  description="Rebuilt from a 2015 lightning gag. Drop any portrait into a 3-layer procedural rain and branching lightning storm, synthesize thunder, and export a dramatic PNG."
  showNav={true}
  backHref="/gallery/"
  backLabel="Gallery"
  navSection="Storm Studio"
>
  <main class="min-h-[calc(100dvh-4rem)] void-grid py-7 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto space-y-5 animate-rise">
      <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-crimson">EP.07 // PROCEDURAL STORM ENGINE</div>
          <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-bone tracking-tight mt-1">
            Villain Storm Studio
          </h1>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button id="strikeBtn" type="button" class="px-4 py-2 rounded-full bg-crimson hover:bg-crimson-glow text-white font-mono text-xs uppercase tracking-wider font-bold cursor-pointer shadow-[0_0_24px_rgba(255,34,68,0.45)] transition">⚡ Strike Now</button>
          <button id="soundBtn" type="button" aria-pressed="false" class="px-4 py-2 rounded-full border border-white/15 bg-white/[0.04] hover:border-white/40 text-bone font-mono text-xs uppercase tracking-wider cursor-pointer transition">Sound: Off</button>
          <label class="px-4 py-2 rounded-full border border-white/15 bg-white/[0.04] hover:border-crimson/60 text-bone font-mono text-xs uppercase tracking-wider cursor-pointer transition">
            Upload Portrait
            <input id="stormFile" type="file" accept="image/*" class="hidden" />
          </label>
          <button id="snapBtn" type="button" class="px-4 py-2 rounded-full bg-bone text-void font-mono text-xs uppercase tracking-wider font-bold cursor-pointer hover:opacity-90 transition">Snapshot PNG</button>
        </div>
      </header>

      <!-- Controls -->
      <section class="rounded-2xl bg-surface border border-white/[0.09] p-4 sm:p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-center">
        <label class="space-y-1.5 font-mono text-xs text-ash">
          <span>DRAMATIC CAPTION</span>
          <input id="captionInput" type="text" value="UNSPEAKABLE EVIL" maxlength="36" class="w-full px-3 py-2 rounded-lg bg-void border border-white/15 text-bone text-xs font-mono focus:border-crimson focus:outline-none" />
        </label>

        <label class="space-y-1.5 font-mono text-xs text-ash">
          <div class="flex justify-between"><span>RAIN</span><span id="rainVal" class="text-bone">280 drops</span></div>
          <input id="rainRange" type="range" min="40" max="550" value="280" class="w-full accent-[#ff2244]" />
        </label>

        <label class="space-y-1.5 font-mono text-xs text-ash">
          <div class="flex justify-between"><span>STORM FREQUENCY</span><span id="freqVal" class="text-bone">Medium</span></div>
          <input id="freqRange" type="range" min="1" max="5" step="1" value="3" class="w-full accent-[#ff2244]" />
        </label>

        <label class="space-y-1.5 font-mono text-xs text-ash">
          <span>LIGHTNING TINT</span>
          <select id="boltTint" class="w-full px-3 py-2 rounded-lg bg-void border border-white/15 text-bone text-xs font-mono">
            <option value="crimson">LD+R Crimson</option>
            <option value="electric">Classic Electric Blue</option>
            <option value="amber">Solar Flare Amber</option>
            <option value="white">Stark White</option>
          </select>
        </label>
      </section>

      <!-- Live 3-Layer Procedural Storm Stage -->
      <section class="relative rounded-3xl overflow-hidden border border-white/12 bg-[#040406] shadow-2xl aspect-[16/9] max-h-[68dvh] w-full">
        <canvas id="stormCanvas" class="w-full h-full block cursor-crosshair"></canvas>
        <div class="pointer-events-none absolute bottom-3 left-4 font-mono text-[10px] uppercase tracking-[0.2em] text-white/35">
          CLICK ANYWHERE ON THE SKY TO CALL LIGHTNING
        </div>
      </section>
    </div>
  </main>

  <script>
    let cleanupStorm: (() => void) | null = null;

    function initStorm() {
      if (cleanupStorm) {
        cleanupStorm();
        cleanupStorm = null;
      }

      const canvas = document.getElementById('stormCanvas') as HTMLCanvasElement | null;
      const rainRange = document.getElementById('rainRange') as HTMLInputElement | null;
      const freqRange = document.getElementById('freqRange') as HTMLInputElement | null;
      const captionInput = document.getElementById('captionInput') as HTMLInputElement | null;
      const boltTint = document.getElementById('boltTint') as HTMLSelectElement | null;
      const soundBtn = document.getElementById('soundBtn') as HTMLButtonElement | null;
      const rainVal = document.getElementById('rainVal')!;
      const freqVal = document.getElementById('freqVal')!;
      if (!canvas || !rainRange || !freqRange || !captionInput || !boltTint) return;

      const ctx = canvas.getContext('2d')!;
      const TINT_MAP: Record<string, { core: string; glow: string; flash: string }> = {
        crimson: { core: '#fff1f2', glow: '#ff2244', flash: 'rgba(255, 34, 68, ' },
        electric: { core: '#f0f9ff', glow: '#38bdf8', flash: 'rgba(186, 230, 253, ' },
        amber: { core: '#fffbeb', glow: '#f59e0b', flash: 'rgba(251, 191, 36, ' },
        white: { core: '#ffffff', glow: '#e4e4e7', flash: 'rgba(255, 255, 255, ' },
      };

      const FREQ_LABELS = ['Rare', 'Low', 'Medium', 'Heavy', 'Apocalypse'];

      let width = 960;
      let height = 540;
      let userImg: HTMLImageElement | null = null;
      let soundOn = false;
      let audioCtx: AudioContext | null = null;
      let flash = 0;
      let shakeX = 0;
      let shakeY = 0;
      let rafId = 0;

      interface Drop { x: number; y: number; len: number; spd: number; wind: number; alpha: number; }
      interface BoltSegment { x1: number; y1: number; x2: number; y2: number; width: number; }
      interface Bolt { segments: BoltSegment[]; life: number; }

      let drops: Drop[] = [];
      let bolts: Bolt[] = [];

      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = canvas!.clientWidth || 960;
        height = canvas!.clientHeight || 540;
        canvas!.width = Math.floor(width * dpr);
        canvas!.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        syncDrops();
      }

      function syncDrops() {
        const target = parseInt(rainRange!.value, 10);
        rainVal.textContent = `${target} drops`;
        while (drops.length < target) {
          drops.push({
            x: Math.random() * width,
            y: Math.random() * height,
            len: 12 + Math.random() * 24,
            spd: 11 + Math.random() * 14,
            wind: 2.2 + Math.random() * 2,
            alpha: 0.14 + Math.random() * 0.35,
          });
        }
        if (drops.length > target) drops.length = target;
      }

      function synthThunder() {
        if (!soundOn) return;
        try {
          if (!audioCtx) audioCtx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const dur = 1.9;
          const bufferSize = Math.floor(audioCtx.sampleRate * dur);
          const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            const env = Math.pow(1 - i / bufferSize, 1.8);
            data[i] = (Math.random() * 2 - 1) * env;
          }
          const src = audioCtx.createBufferSource();
          src.buffer = buffer;
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(240, audioCtx.currentTime);
          filter.frequency.exponentialRampToValueAtTime(48, audioCtx.currentTime + dur);
          const gain = audioCtx.createGain();
          gain.gain.setValueAtTime(0.55, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
          src.connect(filter).connect(gain).connect(audioCtx.destination);
          src.start();
        } catch {}
      }

      function createBranch(x: number, y: number, targetY: number, segWidth: number, depth: number, out: BoltSegment[]) {
        let cx = x;
        let cy = y;
        while (cy < targetY) {
          const nx = cx + (Math.random() - 0.48) * (depth === 0 ? 44 : 28);
          const ny = cy + 14 + Math.random() * 24;
          out.push({ x1: cx, y1: cy, x2: nx, y2: ny, width: segWidth });
          if (depth < 2 && Math.random() < 0.24) {
            createBranch(nx, ny, Math.min(targetY, ny + 70 + Math.random() * 110), segWidth * 0.55, depth + 1, out);
          }
          cx = nx;
          cy = ny;
        }
      }

      function triggerStrike(startX?: number) {
        const sx = startX ?? (width * 0.15 + Math.random() * width * 0.7);
        const segs: BoltSegment[] = [];
        createBranch(sx, 0, height * (0.65 + Math.random() * 0.32), 3.2, 0, segs);
        bolts.push({ segments: segs, life: 1 });
        flash = 0.72;
        shakeX = (Math.random() - 0.5) * 14;
        shakeY = (Math.random() - 0.5) * 10;
        synthThunder();
      }

      function drawSilhouette() {
        const cx = width / 2;
        const cy = height * 0.52;
        ctx.save();
        if (userImg) {
          const scale = Math.max(width / userImg.width, height / userImg.height);
          const dw = userImg.width * scale;
          const dh = userImg.height * scale;
          ctx.filter = `grayscale(85%) contrast(135%) brightness(${0.28 + flash * 0.85})`;
          ctx.drawImage(userImg, (width - dw) / 2, (height - dh) / 2, dw, dh);
          ctx.filter = 'none';
        } else {
          // Ominous villain silhouette revealed by lightning flash
          const vis = 0.14 + flash * 0.75;
          ctx.fillStyle = `rgba(244, 243, 239, ${vis * 0.22})`;
          ctx.beginPath();
          ctx.arc(cx, cy - 58, 56, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.ellipse(cx, cy + 120, 145, 130, 0, Math.PI, Math.PI * 2);
          ctx.fill();

          // Glowing eyes
          const tint = TINT_MAP[boltTint!.value] || TINT_MAP.crimson;
          ctx.fillStyle = tint.glow;
          ctx.shadowColor = tint.glow;
          ctx.shadowBlur = 18 + flash * 26;
          ctx.beginPath();
          ctx.ellipse(cx - 20, cy - 60, 8, 3.5, 0.15, 0, Math.PI * 2);
          ctx.ellipse(cx + 20, cy - 60, 8, 3.5, -0.15, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        }
        ctx.restore();
      }

      function tick() {
        const tint = TINT_MAP[boltTint!.value] || TINT_MAP.crimson;
        const freq = parseInt(freqRange!.value, 10);
        freqVal.textContent = FREQ_LABELS[freq - 1] || 'Medium';

        if (Math.random() < freq * 0.0045) triggerStrike();

        ctx.save();
        ctx.translate(shakeX, shakeY);
        shakeX *= 0.8;
        shakeY *= 0.8;

        // Sky backdrop
        const bg = ctx.createLinearGradient(0, 0, 0, height);
        bg.addColorStop(0, '#040407');
        bg.addColorStop(1, '#0c0c12');
        ctx.fillStyle = bg;
        ctx.fillRect(-20, -20, width + 40, height + 40);

        drawSilhouette();

        // Ambient storm flash overlay
        if (flash > 0.01) {
          ctx.fillStyle = `${tint.flash}${(flash * 0.38).toFixed(3)})`;
          ctx.fillRect(-20, -20, width + 40, height + 40);
          flash *= 0.86;
        }

        // Branching lightning bolts
        for (let i = bolts.length - 1; i >= 0; i--) {
          const b = bolts[i];
          ctx.save();
          ctx.globalAlpha = b.life;
          ctx.lineCap = 'round';
          ctx.shadowColor = tint.glow;
          ctx.shadowBlur = 24;
          for (const seg of b.segments) {
            ctx.strokeStyle = tint.glow;
            ctx.lineWidth = seg.width * 2.1;
            ctx.beginPath();
            ctx.moveTo(seg.x1, seg.y1);
            ctx.lineTo(seg.x2, seg.y2);
            ctx.stroke();

            ctx.strokeStyle = tint.core;
            ctx.lineWidth = seg.width * 0.75;
            ctx.beginPath();
            ctx.moveTo(seg.x1, seg.y1);
            ctx.lineTo(seg.x2, seg.y2);
            ctx.stroke();
          }
          ctx.restore();
          b.life -= 0.07;
          if (b.life <= 0) bolts.splice(i, 1);
        }

        // Rain streaks
        ctx.strokeStyle = 'rgba(220, 225, 240, 0.35)';
        ctx.lineWidth = 1.15;
        ctx.beginPath();
        for (const d of drops) {
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.wind * 2.5, d.y + d.len);
          d.x += d.wind;
          d.y += d.spd;
          if (d.y > height) {
            d.y = -d.len;
            d.x = Math.random() * width;
          }
          if (d.x > width) d.x -= width;
        }
        ctx.stroke();

        // Dramatic bottom caption
        const caption = captionInput!.value.trim();
        if (caption) {
          ctx.save();
          ctx.font = `800 ${Math.max(22, Math.round(width * 0.048))}px "Syne", sans-serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'bottom';
          ctx.shadowColor = tint.glow;
          ctx.shadowBlur = 12 + flash * 32;
          ctx.fillStyle = `rgba(244, 243, 239, ${0.62 + flash * 0.38})`;
          ctx.fillText(caption.toUpperCase(), width / 2, height - 28);
          ctx.restore();
        }

        ctx.restore();
        rafId = requestAnimationFrame(tick);
      }

      resize();
      triggerStrike(width * 0.62);
      rafId = requestAnimationFrame(tick);

      const onResize = () => resize();
      window.addEventListener('resize', onResize);
      rainRange.addEventListener('input', syncDrops);

      canvas.addEventListener('click', (e) => {
        const r = canvas.getBoundingClientRect();
        triggerStrike(e.clientX - r.left);
      });

      document.getElementById('strikeBtn')?.addEventListener('click', () => triggerStrike());

      soundBtn?.addEventListener('click', () => {
        soundOn = !soundOn;
        soundBtn.setAttribute('aria-pressed', String(soundOn));
        soundBtn.textContent = soundOn ? 'Sound: On' : 'Sound: Off';
        if (soundOn) triggerStrike();
      });

      const fileInput = document.getElementById('stormFile') as HTMLInputElement | null;
      fileInput?.addEventListener('change', () => {
        const f = fileInput.files?.[0];
        if (!f) return;
        const url = URL.createObjectURL(f);
        const img = new Image();
        img.onload = () => {
          userImg = img;
          URL.revokeObjectURL(url);
          triggerStrike();
        };
        img.src = url;
      });

      document.getElementById('snapBtn')?.addEventListener('click', () => {
        triggerStrike();
        setTimeout(() => {
          const a = document.createElement('a');
          a.download = 'soodey-villain-storm.png';
          a.href = canvas.toDataURL('image/png');
          a.click();
        }, 60);
      });

      cleanupStorm = () => {
        cancelAnimationFrame(rafId);
        window.removeEventListener('resize', onResize);
      };
    }

    document.addEventListener('astro:page-load', initStorm);
    document.addEventListener('astro:before-swap', () => { cleanupStorm?.(); cleanupStorm = null; });
    initStorm();
  </script>
</BaseLayout>
