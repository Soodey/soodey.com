---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ssaNames from '../../../data/baby-names.json';

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<BaseLayout
  title="Baby Name Generator — soodey.com"
  description="Real weighted US baby name generator with gender filters, popularity tiers, starting letter, lockable first and middle names, and a saved shortlist."
  showNav={true}
  backHref="/gallery/"
  backLabel="Gallery"
  navSection="Baby Name Generator"
>
  <canvas id="confettiCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-50" aria-hidden="true"></canvas>

  <main class="min-h-[calc(100dvh-4rem)] void-grid py-8 px-4 sm:px-8">
    <div class="max-w-4xl mx-auto space-y-6 animate-rise">
      <header class="flex flex-wrap items-end justify-between gap-4">
        <div class="space-y-1">
          <h1 class="font-display font-bold text-3xl sm:text-4xl text-bone tracking-[-0.03em] m-0">
            Baby Name Generator
          </h1>
          <p class="text-sm text-ash m-0">
            3,611 weighted US Social Security names · filter by gender, popularity, or starting letter.
          </p>
        </div>
        <button
          id="shareLinkBtn"
          type="button"
          class="px-4 py-2 rounded-full border border-white/15 bg-white/[0.04] hover:border-white/35 text-xs font-medium text-bone cursor-pointer transition"
        >
          Copy Share Link
        </button>
      </header>

      <!-- Main Name Stage -->
      <section class="relative rounded-3xl bg-surface border border-white/10 p-7 sm:p-12 text-center overflow-hidden shadow-2xl">
        <div
          id="stageGlow"
          class="pointer-events-none absolute inset-0 opacity-25 transition-all duration-500"
          style="background: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.12), transparent 68%);"
        ></div>

        <div class="relative z-10 space-y-5">
          <div id="genderBadge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/12 font-mono text-[11px] uppercase tracking-[0.14em] text-ash">
            Ready
          </div>

          <div
            id="resultName"
            class="font-display font-bold tracking-[-0.03em] text-bone leading-[1.1] min-h-[4.25rem] flex items-center justify-center"
            style="font-size: clamp(2rem, 5.5vw, 3.75rem);"
          >
            Generate a Name
          </div>

          <div id="resultMeta" class="font-mono text-xs text-ash min-h-[1.25rem]">
            Press Space or click Generate
          </div>

          <!-- Lock First / Lock Middle Pills -->
          <div id="lockRow" class="flex flex-wrap items-center justify-center gap-2" hidden>
            <button
              id="lockFirstBtn"
              type="button"
              aria-pressed="false"
              class="px-3 py-1.5 rounded-full border border-white/12 bg-white/[0.03] hover:border-white/30 text-xs text-ash cursor-pointer transition"
            >
              Lock First
            </button>
            <button
              id="lockMiddleBtn"
              type="button"
              aria-pressed="false"
              class="px-3 py-1.5 rounded-full border border-white/12 bg-white/[0.03] hover:border-white/30 text-xs text-ash cursor-pointer transition"
            >
              Lock Middle
            </button>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <button
              id="rollBtn"
              type="button"
              class="px-8 py-3.5 rounded-full bg-bone hover:opacity-90 text-void text-sm font-semibold cursor-pointer active:scale-[0.98] transition"
            >
              Generate Name
            </button>
            <button
              id="saveFavBtn"
              type="button"
              disabled
              class="px-5 py-3.5 rounded-full border border-white/15 bg-white/[0.04] hover:border-white/40 disabled:opacity-35 text-bone text-xs font-medium cursor-pointer disabled:cursor-not-allowed transition"
            >
              Save to Shortlist
            </button>
            <button
              id="copyNameBtn"
              type="button"
              disabled
              class="px-5 py-3.5 rounded-full border border-white/15 bg-white/[0.04] hover:border-white/40 disabled:opacity-35 text-bone text-xs font-medium cursor-pointer disabled:cursor-not-allowed transition"
            >
              Copy
            </button>
          </div>
        </div>
      </section>

      <!-- Filters & Options -->
      <section class="rounded-2xl bg-surface border border-white/[0.08] p-5 sm:p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2 space-y-1.5">
              <label for="lastNameInput" class="block text-xs font-medium text-ash">
                Last Name (optional)
              </label>
              <input
                id="lastNameInput"
                type="text"
                placeholder="e.g. Smith, Miller..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-void border border-white/15 focus:border-white/50 focus:outline-none text-sm text-bone placeholder:text-white/25"
              />
            </div>
            <div class="space-y-1.5">
              <label for="letterSelect" class="block text-xs font-medium text-ash">
                Starts With
              </label>
              <select
                id="letterSelect"
                class="w-full px-3 py-2.5 rounded-xl bg-void border border-white/15 focus:border-white/50 focus:outline-none text-sm text-bone"
              >
                <option value="">Any</option>
                {letters.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
          </div>

          <div class="space-y-1.5">
            <span class="block text-xs font-medium text-ash">Popularity</span>
            <div class="grid grid-cols-2 gap-2" role="group" aria-label="Popularity tier">
              <button type="button" data-tier="weighted" class="tier-btn px-3 py-2 rounded-xl border border-bone bg-bone text-void text-xs font-semibold cursor-pointer transition">Real-World Weighted</button>
              <button type="button" data-tier="top100" class="tier-btn px-3 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Top 100 Classics</button>
              <button type="button" data-tier="gems" class="tier-btn px-3 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Hidden Gems (#250–1000)</button>
              <button type="button" data-tier="rare" class="tier-btn px-3 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Rare (#1000+)</button>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="space-y-1.5">
            <span class="block text-xs font-medium text-ash">Gender</span>
            <div class="grid grid-cols-4 gap-2" role="group" aria-label="Gender filter">
              <button type="button" data-gender="any" class="gender-btn px-2 py-2 rounded-xl border border-bone bg-bone text-void text-xs font-semibold cursor-pointer transition">Any</button>
              <button type="button" data-gender="boy" class="gender-btn px-2 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Boy</button>
              <button type="button" data-gender="girl" class="gender-btn px-2 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Girl</button>
              <button type="button" data-gender="unisex" class="gender-btn px-2 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition">Unisex</button>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-5 pt-2">
            <label class="inline-flex items-center gap-2 text-xs text-bone cursor-pointer">
              <input id="middleToggle" type="checkbox" checked class="w-4 h-4 accent-[#ef3b4e] cursor-pointer" />
              <span>Include Middle Name</span>
            </label>
            <label class="inline-flex items-center gap-2 text-xs text-bone cursor-pointer">
              <input id="confettiToggle" type="checkbox" class="w-4 h-4 accent-[#ef3b4e] cursor-pointer" />
              <span>Confetti</span>
            </label>
          </div>

          <p class="text-xs text-white/40 m-0 leading-relaxed">
            Settings sync with the page URL so you can send a pre-filled link with a specific last name.
          </p>
        </div>
      </section>

      <!-- Shortlist -->
      <section id="favSection" class="rounded-2xl bg-surface border border-white/[0.08] p-5 space-y-3" hidden>
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-bone m-0">Shortlist</h2>
          <button id="clearFavsBtn" type="button" class="text-xs text-ash hover:text-bone underline bg-transparent border-0 cursor-pointer">Clear All</button>
        </div>
        <ul id="favList" class="list-none p-0 m-0 flex flex-wrap gap-2"></ul>
      </section>
    </div>
  </main>

  <script id="ssaData" type="application/json" set:html={JSON.stringify(ssaNames)}></script>

  <script>
    function initBabyGenerator() {
      const dataEl = document.getElementById('ssaData');
      const rollBtn = document.getElementById('rollBtn') as HTMLButtonElement | null;
      const lastNameInput = document.getElementById('lastNameInput') as HTMLInputElement | null;
      const letterSelect = document.getElementById('letterSelect') as HTMLSelectElement | null;
      const middleToggle = document.getElementById('middleToggle') as HTMLInputElement | null;
      const confettiToggle = document.getElementById('confettiToggle') as HTMLInputElement | null;
      const resultName = document.getElementById('resultName');
      const resultMeta = document.getElementById('resultMeta');
      const genderBadge = document.getElementById('genderBadge');
      const stageGlow = document.getElementById('stageGlow') as HTMLElement | null;
      const lockRow = document.getElementById('lockRow') as HTMLElement | null;
      const lockFirstBtn = document.getElementById('lockFirstBtn') as HTMLButtonElement | null;
      const lockMiddleBtn = document.getElementById('lockMiddleBtn') as HTMLButtonElement | null;
      const saveFavBtn = document.getElementById('saveFavBtn') as HTMLButtonElement | null;
      const copyNameBtn = document.getElementById('copyNameBtn') as HTMLButtonElement | null;
      const shareLinkBtn = document.getElementById('shareLinkBtn') as HTMLButtonElement | null;
      const favSection = document.getElementById('favSection') as HTMLElement | null;
      const favList = document.getElementById('favList') as HTMLElement | null;
      const confettiCanvas = document.getElementById('confettiCanvas') as HTMLCanvasElement | null;

      if (!dataEl || !rollBtn || !lastNameInput || !letterSelect || !resultName || !resultMeta || !genderBadge || !confettiCanvas) return;

      const ssa: { boy: [string, number][]; girl: [string, number][]; unisex: [string, number][] } = JSON.parse(
        dataEl.textContent || '{"boy":[],"girl":[],"unisex":[]}'
      );

      let tier: 'weighted' | 'top100' | 'gems' | 'rare' = 'weighted';
      let gender: 'any' | 'boy' | 'girl' | 'unisex' = 'any';
      let currentFirst = '';
      let currentMiddle = '';
      let currentFull = '';
      let currentGender: 'boy' | 'girl' | 'unisex' = 'boy';
      let lockFirst = false;
      let lockMiddle = false;
      let favorites: string[] = [];

      try {
        favorites = JSON.parse(localStorage.getItem('soodey-baby-shortlist') || '[]');
      } catch {}

      const params = new URLSearchParams(window.location.search);
      if (params.get('last')) lastNameInput.value = params.get('last') || '';
      if (params.get('letter')) letterSelect.value = (params.get('letter') || '').toUpperCase();
      if (['weighted', 'top100', 'gems', 'rare'].includes(params.get('tier') || '')) tier = params.get('tier') as typeof tier;
      if (['any', 'boy', 'girl', 'unisex'].includes(params.get('gender') || '')) gender = params.get('gender') as typeof gender;

      function syncUrl() {
        const u = new URL(window.location.href);
        const last = lastNameInput!.value.trim();
        if (last) u.searchParams.set('last', last);
        else u.searchParams.delete('last');
        if (letterSelect!.value) u.searchParams.set('letter', letterSelect!.value);
        else u.searchParams.delete('letter');
        u.searchParams.set('tier', tier);
        u.searchParams.set('gender', gender);
        history.replaceState(null, '', u.toString());
      }

      function updateButtons() {
        document.querySelectorAll('.tier-btn').forEach((b) => {
          const on = (b as HTMLElement).dataset.tier === tier;
          b.className = on
            ? 'tier-btn px-3 py-2 rounded-xl border border-bone bg-bone text-void text-xs font-semibold cursor-pointer transition'
            : 'tier-btn px-3 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition';
        });
        document.querySelectorAll('.gender-btn').forEach((b) => {
          const on = (b as HTMLElement).dataset.gender === gender;
          b.className = on
            ? 'gender-btn px-2 py-2 rounded-xl border border-bone bg-bone text-void text-xs font-semibold cursor-pointer transition'
            : 'gender-btn px-2 py-2 rounded-xl border border-white/12 bg-white/[0.03] text-ash hover:text-bone text-xs cursor-pointer transition';
        });
        if (lockFirstBtn) {
          lockFirstBtn.setAttribute('aria-pressed', String(lockFirst));
          lockFirstBtn.textContent = lockFirst ? `Locked: ${currentFirst}` : 'Lock First';
          lockFirstBtn.className = lockFirst
            ? 'px-3 py-1.5 rounded-full border border-bone bg-bone/15 text-xs text-bone font-medium cursor-pointer transition'
            : 'px-3 py-1.5 rounded-full border border-white/12 bg-white/[0.03] hover:border-white/30 text-xs text-ash cursor-pointer transition';
        }
        if (lockMiddleBtn) {
          lockMiddleBtn.hidden = !(middleToggle?.checked ?? true);
          lockMiddleBtn.setAttribute('aria-pressed', String(lockMiddle));
          lockMiddleBtn.textContent = lockMiddle ? `Locked: ${currentMiddle}` : 'Lock Middle';
          lockMiddleBtn.className = lockMiddle
            ? 'px-3 py-1.5 rounded-full border border-bone bg-bone/15 text-xs text-bone font-medium cursor-pointer transition'
            : 'px-3 py-1.5 rounded-full border border-white/12 bg-white/[0.03] hover:border-white/30 text-xs text-ash cursor-pointer transition';
        }
      }

      function getPool(g: 'boy' | 'girl' | 'unisex', applyLetter: boolean): [string, number][] {
        const full = ssa[g];
        let sliced = full;
        if (tier === 'top100') sliced = full.slice(0, 100);
        else if (tier === 'gems') sliced = full.length > 250 ? full.slice(249, 1000) : full.slice(Math.floor(full.length * 0.25));
        else if (tier === 'rare') sliced = full.length > 1000 ? full.slice(999) : full.slice(Math.floor(full.length * 0.5));

        const letter = applyLetter ? letterSelect!.value : '';
        if (letter) {
          const filtered = sliced.filter(([n]) => n.toUpperCase().startsWith(letter));
          if (filtered.length > 0) return filtered;
          const fallback = full.filter(([n]) => n.toUpperCase().startsWith(letter));
          if (fallback.length > 0) return fallback;
        }
        return sliced;
      }

      function pickWeighted(list: [string, number][], useWeights: boolean): [string, number] {
        if (!useWeights) return list[Math.floor(Math.random() * list.length)];
        const total = list.reduce((acc, [, w]) => acc + w, 0);
        let r = Math.random() * total;
        for (const entry of list) {
          r -= entry[1];
          if (r <= 0) return entry;
        }
        return list[0];
      }

      // Lightweight native Canvas confetti
      const cCtx = confettiCanvas.getContext('2d')!;
      interface Piece { x: number; y: number; vx: number; vy: number; size: number; color: string; rot: number; vr: number; life: number; }
      let pieces: Piece[] = [];
      let confettiRaf = 0;

      function launchConfetti(primaryColor: string) {
        if (!confettiToggle?.checked) return;
        confettiCanvas!.width = window.innerWidth;
        confettiCanvas!.height = window.innerHeight;
        const palette = [primaryColor, '#f5f5f7', '#fbbf24'];
        for (let i = 0; i < 65; i++) {
          const ang = -Math.PI / 2 + (Math.random() - 0.5) * 1.3;
          const spd = 6 + Math.random() * 11;
          pieces.push({
            x: window.innerWidth / 2,
            y: window.innerHeight * 0.42,
            vx: Math.cos(ang) * spd,
            vy: Math.sin(ang) * spd - 2,
            size: 5 + Math.random() * 5,
            color: palette[i % palette.length],
            rot: Math.random() * Math.PI * 2,
            vr: (Math.random() - 0.5) * 0.22,
            life: 1,
          });
        }
        if (!confettiRaf) tickConfetti();
      }

      function tickConfetti() {
        cCtx.clearRect(0, 0, confettiCanvas!.width, confettiCanvas!.height);
        for (let i = pieces.length - 1; i >= 0; i--) {
          const p = pieces[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.28;
          p.rot += p.vr;
          p.life -= 0.012;
          if (p.life <= 0 || p.y > confettiCanvas!.height + 20) {
            pieces.splice(i, 1);
            continue;
          }
          cCtx.save();
          cCtx.translate(p.x, p.y);
          cCtx.rotate(p.rot);
          cCtx.globalAlpha = Math.min(1, p.life * 1.5);
          cCtx.fillStyle = p.color;
          cCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
          cCtx.restore();
        }
        if (pieces.length > 0) confettiRaf = requestAnimationFrame(tickConfetti);
        else confettiRaf = 0;
      }

      function renderFavs() {
        if (!favSection || !favList) return;
        favSection.hidden = favorites.length === 0;
        favList.innerHTML = '';
        favorites.forEach((name, idx) => {
          const li = document.createElement('li');
          li.className = 'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.05] border border-white/12 text-xs text-bone';
          const span = document.createElement('span');
          span.textContent = name;
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.textContent = '×';
          rm.className = 'text-ash hover:text-crimson bg-transparent border-0 cursor-pointer text-sm leading-none';
          rm.addEventListener('click', () => {
            favorites.splice(idx, 1);
            try { localStorage.setItem('soodey-baby-shortlist', JSON.stringify(favorites)); } catch {}
            renderFavs();
          });
          li.appendChild(span);
          li.appendChild(rm);
          favList.appendChild(li);
        });
      }

      function displayCurrent() {
        const last = lastNameInput!.value.trim();
        const includeMiddle = middleToggle?.checked ?? true;
        currentFull = [currentFirst, includeMiddle ? currentMiddle : '', last].filter(Boolean).join(' ');
        resultName!.textContent = currentFull;
      }

      function roll() {
        syncUrl();
        const g: 'boy' | 'girl' | 'unisex' =
          lockFirst || lockMiddle
            ? currentGender
            : gender === 'any'
              ? (Math.random() < 0.5 ? 'boy' : 'girl')
              : gender;
        currentGender = g;

        const firstPool = getPool(g, true);
        const middlePool = getPool(g, false);
        const useWeights = tier === 'weighted';

        if (!lockFirst || !currentFirst) {
          currentFirst = pickWeighted(firstPool, useWeights)[0];
        }

        const includeMiddle = middleToggle?.checked ?? true;
        if (includeMiddle && (!lockMiddle || !currentMiddle || currentMiddle === currentFirst)) {
          let tries = 0;
          do {
            currentMiddle = pickWeighted(middlePool, useWeights)[0];
            tries++;
          } while (currentMiddle === currentFirst && tries < 10);
        }

        const fullList = ssa[g];
        const firstRank = fullList.findIndex(([n]) => n === currentFirst) + 1;
        const firstWeight = fullList[firstRank - 1]?.[1] ?? 0;

        const badgeMap = {
          boy: { label: 'Boy', color: '#38bdf8', glow: 'rgba(56,189,248,0.28)' },
          girl: { label: 'Girl', color: '#f43f5e', glow: 'rgba(244,63,94,0.28)' },
          unisex: { label: 'Unisex', color: '#f59e0b', glow: 'rgba(245,158,11,0.26)' },
        }[g];

        displayCurrent();
        genderBadge!.textContent = badgeMap.label;
        genderBadge!.style.color = badgeMap.color;
        genderBadge!.style.borderColor = `${badgeMap.color}55`;
        if (stageGlow) {
          stageGlow.style.background = `radial-gradient(circle at 50% 0%, ${badgeMap.glow}, transparent 68%)`;
        }

        resultMeta!.textContent = firstRank
          ? `${currentFirst} — Rank #${firstRank} (${firstWeight.toLocaleString()} US births)`
          : '';

        if (lockRow) lockRow.hidden = false;
        if (saveFavBtn) saveFavBtn.disabled = false;
        if (copyNameBtn) copyNameBtn.disabled = false;
        updateButtons();
        launchConfetti(badgeMap.color);
      }

      rollBtn.addEventListener('click', roll);
      lastNameInput.addEventListener('input', () => {
        syncUrl();
        if (currentFirst) displayCurrent();
      });
      letterSelect.addEventListener('change', () => {
        lockFirst = false;
        syncUrl();
        updateButtons();
      });
      middleToggle?.addEventListener('change', () => {
        if (!middleToggle.checked) lockMiddle = false;
        if (currentFirst) displayCurrent();
        updateButtons();
      });

      lockFirstBtn?.addEventListener('click', () => {
        lockFirst = !lockFirst;
        updateButtons();
      });
      lockMiddleBtn?.addEventListener('click', () => {
        lockMiddle = !lockMiddle;
        updateButtons();
      });

      document.querySelectorAll('.tier-btn').forEach((b) => {
        b.addEventListener('click', () => {
          tier = ((b as HTMLElement).dataset.tier as typeof tier) || 'weighted';
          updateButtons();
          syncUrl();
        });
      });

      document.querySelectorAll('.gender-btn').forEach((b) => {
        b.addEventListener('click', () => {
          gender = ((b as HTMLElement).dataset.gender as typeof gender) || 'any';
          lockFirst = false;
          lockMiddle = false;
          updateButtons();
          syncUrl();
        });
      });

      saveFavBtn?.addEventListener('click', () => {
        if (!currentFull || favorites.includes(currentFull)) return;
        favorites.unshift(currentFull);
        try { localStorage.setItem('soodey-baby-shortlist', JSON.stringify(favorites)); } catch {}
        renderFavs();
      });

      document.getElementById('clearFavsBtn')?.addEventListener('click', () => {
        favorites = [];
        try { localStorage.setItem('soodey-baby-shortlist', '[]'); } catch {}
        renderFavs();
      });

      copyNameBtn?.addEventListener('click', async () => {
        if (!currentFull) return;
        try {
          await navigator.clipboard.writeText(currentFull);
          copyNameBtn.textContent = 'Copied';
          setTimeout(() => (copyNameBtn.textContent = 'Copy'), 1400);
        } catch {}
      });

      shareLinkBtn?.addEventListener('click', async () => {
        syncUrl();
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLinkBtn.textContent = 'Link Copied';
          setTimeout(() => (shareLinkBtn.textContent = 'Copy Share Link'), 1500);
        } catch {}
      });

      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'SELECT') {
          e.preventDefault();
          roll();
        }
      });

      updateButtons();
      renderFavs();
    }

    document.addEventListener('astro:page-load', initBabyGenerator);
    initBabyGenerator();
  </script>
</BaseLayout>
