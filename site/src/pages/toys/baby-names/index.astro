---
import { ClientRouter } from 'astro:transitions';
import '../../../styles/global.css';
import ssaNames from '../../../data/baby-names.json';

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Baby! — soodey.com</title>
  <meta name="description" content="A whimsical US baby name generator with weighted real names, confetti reveals, custom last names, and a saved shortlist." />
  <link rel="canonical" href="https://soodey.com/toys/baby-names/" />
  <meta name="theme-color" content="#a1c4fd" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <ClientRouter />

  <style>
    body.baby-body {
      font-family: "Poppins", -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #a1c4fd 0%, #e0c3fc 48%, #ffc1e3 100%);
      background-attachment: fixed;
      color: #1e293b;
      min-height: 100dvh;
      margin: 0;
      overflow-x: hidden;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes popReveal {
      0% { opacity: 0; transform: scale(0.72) rotate(-2deg); }
      65% { opacity: 1; transform: scale(1.04) rotate(1deg); }
      100% { opacity: 1; transform: scale(1) rotate(0deg); }
    }

    @keyframes gentleWobble {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(1.4deg); }
      75% { transform: rotate(-1.4deg); }
    }

    .cloud-orb {
      animation: floatSlow 7s ease-in-out infinite;
    }

    .reveal-pop {
      animation: popReveal 0.48s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    .reveal-wobble {
      animation: gentleWobble 2.2s ease-in-out infinite;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.72);
      box-shadow: 0 24px 60px rgba(31, 38, 135, 0.18), 0 4px 16px rgba(31, 38, 135, 0.08);
    }

    .btn-baby {
      background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%);
      box-shadow: 0 10px 28px rgba(94, 114, 228, 0.42);
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }

    .btn-baby:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 16px 34px rgba(94, 114, 228, 0.5);
    }

    .btn-baby:active {
      transform: translateY(0) scale(0.97);
    }

    @media (prefers-reduced-motion: reduce) {
      .cloud-orb, .reveal-pop, .reveal-wobble {
        animation: none !important;
      }
    }
  </style>
</head>
<body class="baby-body antialiased">
  <!-- Confetti Layer -->
  <canvas id="confettiCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-50" aria-hidden="true"></canvas>

  <!-- Soft Floating Pastel Glows -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden z-0" aria-hidden="true">
    <div class="cloud-orb absolute -top-24 -left-16 w-80 h-80 rounded-full bg-white/35 blur-3xl"></div>
    <div class="cloud-orb absolute -bottom-24 -right-16 w-96 h-96 rounded-full bg-white/30 blur-3xl" style="animation-delay: -3.5s;"></div>
  </div>

  <!-- Minimal Frosted Top Bar -->
  <header class="relative z-20 max-w-4xl mx-auto px-5 pt-5 flex items-center justify-between gap-3">
    <a
      href="/gallery/"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/75 hover:bg-white text-slate-700 border border-white/80 text-xs font-semibold shadow-sm backdrop-blur-md transition"
    >
      <span aria-hidden="true">←</span>
      <span>Gallery</span>
    </a>

    <div class="flex items-center gap-2">
      <button
        id="customizeToggle"
        type="button"
        aria-expanded="false"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/75 hover:bg-white text-slate-700 border border-white/80 text-xs font-semibold shadow-sm backdrop-blur-md cursor-pointer transition"
      >
        <span>Customize</span>
      </button>
      <button
        id="shareLinkBtn"
        type="button"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/75 hover:bg-white text-slate-700 border border-white/80 text-xs font-semibold shadow-sm backdrop-blur-md cursor-pointer transition"
      >
        <span>Share</span>
      </button>
    </div>
  </header>

  <!-- Center Whimsical Stage -->
  <main class="relative z-10 min-h-[calc(100dvh-4.5rem)] flex flex-col items-center justify-center px-4 py-8 gap-5">
    <!-- Initial / Idle Card -->
    <section
      id="idleCard"
      class="glass-card rounded-[28px] px-8 py-10 sm:px-14 sm:py-12 text-center max-w-xl w-full space-y-6"
    >
      <div class="space-y-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-600 text-xs font-semibold">
          <span>✨</span>
          <span>3,611 Real US Names</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-800 m-0">
          Baby Name Picker
        </h1>
        <p id="idleSubtitle" class="text-sm sm:text-base text-slate-500 m-0">
          Tap the button to welcome a brand new name.
        </p>
      </div>

      <!-- Quick Last Name Bar right on the card -->
      <div class="max-w-xs mx-auto">
        <input
          id="lastNameInput"
          type="text"
          placeholder="Optional last name..."
          aria-label="Optional last name"
          class="w-full px-4 py-2.5 rounded-full bg-white/90 border border-slate-200 focus:border-indigo-400 focus:outline-none text-center text-sm font-medium text-slate-700 placeholder:text-slate-400 shadow-inner transition"
        />
      </div>

      <div class="pt-1">
        <button
          id="rollBtn"
          type="button"
          class="btn-baby text-white font-extrabold text-xl sm:text-2xl px-10 py-4 rounded-2xl border-0 cursor-pointer"
        >
          New Baby!
        </button>
      </div>
    </section>

    <!-- Joyful Reveal Card -->
    <section
      id="revealCard"
      hidden
      class="glass-card rounded-[32px] px-7 py-10 sm:px-14 sm:py-12 text-center max-w-2xl w-full space-y-5"
    >
      <div id="revealInner" class="space-y-4">
        <div
          id="genderHeadline"
          class="text-2xl sm:text-4xl font-extrabold tracking-tight"
        >
          IT'S A BOY!
        </div>

        <div
          id="resultName"
          class="font-extrabold tracking-tight leading-tight text-slate-900 py-1"
          style="font-size: clamp(2.1rem, 6vw, 3.8rem);"
        ></div>

        <div id="resultMeta" class="text-xs sm:text-sm font-medium text-slate-500"></div>

        <!-- Lock Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
          <button
            id="lockFirstBtn"
            type="button"
            aria-pressed="false"
            class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold border border-slate-200/80 cursor-pointer transition"
          >
            Lock First
          </button>
          <button
            id="lockMiddleBtn"
            type="button"
            aria-pressed="false"
            class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold border border-slate-200/80 cursor-pointer transition"
          >
            Lock Middle
          </button>
        </div>
      </div>

      <!-- Reveal Actions -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <button
          id="rollAgainBtn"
          type="button"
          class="btn-baby text-white font-bold text-lg px-8 py-3.5 rounded-2xl border-0 cursor-pointer"
        >
          New Baby!
        </button>
        <button
          id="saveFavBtn"
          type="button"
          class="px-5 py-3.5 rounded-2xl bg-white hover:bg-rose-50 text-slate-700 hover:text-rose-600 border border-slate-200 text-sm font-semibold shadow-sm cursor-pointer transition"
        >
          ♥ Save
        </button>
        <button
          id="copyNameBtn"
          type="button"
          class="px-5 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-semibold shadow-sm cursor-pointer transition"
        >
          Copy
        </button>
      </div>
    </section>

    <!-- Collapsible Customize Drawer -->
    <section
      id="customizePanel"
      hidden
      class="glass-card rounded-3xl p-5 sm:p-6 max-w-2xl w-full grid grid-cols-1 sm:grid-cols-2 gap-5 text-left"
    >
      <div class="space-y-3">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Gender</span>
          <div class="grid grid-cols-4 gap-1.5" role="group" aria-label="Gender">
            <button type="button" data-gender="any" class="gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition">Any</button>
            <button type="button" data-gender="boy" class="gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition">Boy</button>
            <button type="button" data-gender="girl" class="gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition">Girl</button>
            <button type="button" data-gender="unisex" class="gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition">Unisex</button>
          </div>
        </div>

        <div>
          <label for="letterSelect" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Starts With</label>
          <select
            id="letterSelect"
            class="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold"
          >
            <option value="">Any Letter</option>
            {letters.map((l) => <option value={l}>{l}</option>)}
          </select>
        </div>
      </div>

      <div class="space-y-3">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Popularity</span>
          <div class="grid grid-cols-2 gap-1.5" role="group" aria-label="Popularity">
            <button type="button" data-tier="weighted" class="tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition">Weighted</button>
            <button type="button" data-tier="top100" class="tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition">Top 100</button>
            <button type="button" data-tier="gems" class="tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition">Hidden Gems</button>
            <button type="button" data-tier="rare" class="tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition">Rare</button>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-1">
          <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 cursor-pointer">
            <input id="middleToggle" type="checkbox" checked class="w-4 h-4 accent-indigo-600 cursor-pointer" />
            <span>Middle Name</span>
          </label>
          <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 cursor-pointer">
            <input id="confettiToggle" type="checkbox" checked class="w-4 h-4 accent-indigo-600 cursor-pointer" />
            <span>Confetti</span>
          </label>
        </div>
      </div>
    </section>

    <!-- Saved Favorites -->
    <section
      id="favSection"
      hidden
      class="glass-card rounded-3xl px-6 py-4 max-w-2xl w-full space-y-2.5"
    >
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 m-0">Saved Names</h2>
        <button id="clearFavsBtn" type="button" class="text-xs font-semibold text-rose-500 hover:underline bg-transparent border-0 cursor-pointer">Clear</button>
      </div>
      <ul id="favList" class="list-none p-0 m-0 flex flex-wrap gap-2"></ul>
    </section>
  </main>

  <script id="ssaData" type="application/json" set:html={JSON.stringify(ssaNames)}></script>

  <script>
    let cleanupBaby: (() => void) | null = null;

    function initBabyWhimsy() {
      if (cleanupBaby) {
        cleanupBaby();
        cleanupBaby = null;
      }

      const dataEl = document.getElementById('ssaData');
      const idleCard = document.getElementById('idleCard') as HTMLElement | null;
      const revealCard = document.getElementById('revealCard') as HTMLElement | null;
      const revealInner = document.getElementById('revealInner') as HTMLElement | null;
      const genderHeadline = document.getElementById('genderHeadline') as HTMLElement | null;
      const resultName = document.getElementById('resultName') as HTMLElement | null;
      const resultMeta = document.getElementById('resultMeta') as HTMLElement | null;
      const rollBtn = document.getElementById('rollBtn') as HTMLButtonElement | null;
      const rollAgainBtn = document.getElementById('rollAgainBtn') as HTMLButtonElement | null;
      const lastNameInput = document.getElementById('lastNameInput') as HTMLInputElement | null;
      const letterSelect = document.getElementById('letterSelect') as HTMLSelectElement | null;
      const middleToggle = document.getElementById('middleToggle') as HTMLInputElement | null;
      const confettiToggle = document.getElementById('confettiToggle') as HTMLInputElement | null;
      const lockFirstBtn = document.getElementById('lockFirstBtn') as HTMLButtonElement | null;
      const lockMiddleBtn = document.getElementById('lockMiddleBtn') as HTMLButtonElement | null;
      const saveFavBtn = document.getElementById('saveFavBtn') as HTMLButtonElement | null;
      const copyNameBtn = document.getElementById('copyNameBtn') as HTMLButtonElement | null;
      const shareLinkBtn = document.getElementById('shareLinkBtn') as HTMLButtonElement | null;
      const customizeToggle = document.getElementById('customizeToggle') as HTMLButtonElement | null;
      const customizePanel = document.getElementById('customizePanel') as HTMLElement | null;
      const favSection = document.getElementById('favSection') as HTMLElement | null;
      const favList = document.getElementById('favList') as HTMLElement | null;
      const confettiCanvas = document.getElementById('confettiCanvas') as HTMLCanvasElement | null;

      if (!dataEl || !idleCard || !revealCard || !revealInner || !genderHeadline || !resultName || !resultMeta || !rollBtn || !rollAgainBtn || !lastNameInput || !letterSelect || !confettiCanvas) return;

      const ssa: { boy: [string, number][]; girl: [string, number][]; unisex: [string, number][] } = JSON.parse(
        dataEl.textContent || '{"boy":[],"girl":[],"unisex":[]}'
      );

      let tier: 'weighted' | 'top100' | 'gems' | 'rare' = 'weighted';
      let gender: 'any' | 'boy' | 'girl' | 'unisex' = 'any';
      let currentFirst = '';
      let currentMiddle = '';
      let currentFull = '';
      let currentGender: 'boy' | 'girl' | 'unisex' = 'boy';
      let lockFirst = false;
      let lockMiddle = false;
      let favorites: string[] = [];

      try {
        favorites = JSON.parse(localStorage.getItem('soodey-baby-shortlist') || '[]');
      } catch {}

      const params = new URLSearchParams(window.location.search);
      if (params.get('last')) lastNameInput.value = params.get('last') || '';
      if (params.get('letter')) letterSelect.value = (params.get('letter') || '').toUpperCase();
      if (['weighted', 'top100', 'gems', 'rare'].includes(params.get('tier') || '')) tier = params.get('tier') as typeof tier;
      if (['any', 'boy', 'girl', 'unisex'].includes(params.get('gender') || '')) gender = params.get('gender') as typeof gender;

      function syncUrl() {
        const u = new URL(window.location.href);
        const last = lastNameInput!.value.trim();
        if (last) u.searchParams.set('last', last);
        else u.searchParams.delete('last');
        if (letterSelect!.value) u.searchParams.set('letter', letterSelect!.value);
        else u.searchParams.delete('letter');
        u.searchParams.set('tier', tier);
        u.searchParams.set('gender', gender);
        history.replaceState(null, '', u.toString());
      }

      function updateButtons() {
        document.querySelectorAll('.tier-btn').forEach((b) => {
          const on = (b as HTMLElement).dataset.tier === tier;
          b.className = on
            ? 'tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition bg-indigo-600 text-white border border-indigo-600 shadow-sm'
            : 'tier-btn py-2 px-2 rounded-xl text-xs font-semibold cursor-pointer transition bg-white text-slate-600 border border-slate-200 hover:bg-slate-50';
        });
        document.querySelectorAll('.gender-btn').forEach((b) => {
          const on = (b as HTMLElement).dataset.gender === gender;
          b.className = on
            ? 'gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition bg-indigo-600 text-white border border-indigo-600 shadow-sm'
            : 'gender-btn py-2 rounded-xl text-xs font-semibold cursor-pointer transition bg-white text-slate-600 border border-slate-200 hover:bg-slate-50';
        });
        if (lockFirstBtn) {
          lockFirstBtn.setAttribute('aria-pressed', String(lockFirst));
          lockFirstBtn.textContent = lockFirst ? `🔒 ${currentFirst}` : 'Lock First';
          lockFirstBtn.className = lockFirst
            ? 'px-3.5 py-1.5 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold border border-indigo-300 cursor-pointer transition'
            : 'px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold border border-slate-200/80 cursor-pointer transition';
        }
        if (lockMiddleBtn) {
          lockMiddleBtn.hidden = !(middleToggle?.checked ?? true);
          lockMiddleBtn.setAttribute('aria-pressed', String(lockMiddle));
          lockMiddleBtn.textContent = lockMiddle ? `🔒 ${currentMiddle}` : 'Lock Middle';
          lockMiddleBtn.className = lockMiddle
            ? 'px-3.5 py-1.5 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold border border-indigo-300 cursor-pointer transition'
            : 'px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold border border-slate-200/80 cursor-pointer transition';
        }
      }

      function getPool(g: 'boy' | 'girl' | 'unisex', applyLetter: boolean): [string, number][] {
        const full = ssa[g];
        let sliced = full;
        if (tier === 'top100') sliced = full.slice(0, 100);
        else if (tier === 'gems') sliced = full.length > 250 ? full.slice(249, 1000) : full.slice(Math.floor(full.length * 0.25));
        else if (tier === 'rare') sliced = full.length > 1000 ? full.slice(999) : full.slice(Math.floor(full.length * 0.5));

        const letter = applyLetter ? letterSelect!.value : '';
        if (letter) {
          const filtered = sliced.filter(([n]) => n.toUpperCase().startsWith(letter));
          if (filtered.length > 0) return filtered;
          const fallback = full.filter(([n]) => n.toUpperCase().startsWith(letter));
          if (fallback.length > 0) return fallback;
        }
        return sliced;
      }

      function pickWeighted(list: [string, number][], useWeights: boolean): [string, number] {
        if (!useWeights) return list[Math.floor(Math.random() * list.length)];
        const total = list.reduce((acc, [, w]) => acc + w, 0);
        let r = Math.random() * total;
        for (const entry of list) {
          r -= entry[1];
          if (r <= 0) return entry;
        }
        return list[0];
      }

      // Joyful multi-burst Canvas confetti
      const cCtx = confettiCanvas.getContext('2d')!;
      interface Piece { x: number; y: number; vx: number; vy: number; w: number; h: number; color: string; rot: number; vr: number; life: number; }
      let pieces: Piece[] = [];
      let confettiRaf = 0;

      function launchConfetti(themeColors: string[]) {
        if (!confettiToggle?.checked) return;
        confettiCanvas!.width = window.innerWidth;
        confettiCanvas!.height = window.innerHeight;
        for (let i = 0; i < 120; i++) {
          const ang = -Math.PI / 2 + (Math.random() - 0.5) * 1.55;
          const spd = 7 + Math.random() * 14;
          pieces.push({
            x: window.innerWidth / 2 + (Math.random() - 0.5) * 80,
            y: window.innerHeight * 0.52,
            vx: Math.cos(ang) * spd,
            vy: Math.sin(ang) * spd - 3,
            w: 6 + Math.random() * 6,
            h: 4 + Math.random() * 5,
            color: themeColors[i % themeColors.length],
            rot: Math.random() * Math.PI * 2,
            vr: (Math.random() - 0.5) * 0.25,
            life: 1,
          });
        }
        if (!confettiRaf) tickConfetti();
      }

      function tickConfetti() {
        cCtx.clearRect(0, 0, confettiCanvas!.width, confettiCanvas!.height);
        for (let i = pieces.length - 1; i >= 0; i--) {
          const p = pieces[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.27;
          p.vx *= 0.99;
          p.rot += p.vr;
          p.life -= 0.009;
          if (p.life <= 0 || p.y > confettiCanvas!.height + 30) {
            pieces.splice(i, 1);
            continue;
          }
          cCtx.save();
          cCtx.translate(p.x, p.y);
          cCtx.rotate(p.rot);
          cCtx.globalAlpha = Math.min(1, p.life * 1.6);
          cCtx.fillStyle = p.color;
          cCtx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          cCtx.restore();
        }
        if (pieces.length > 0) confettiRaf = requestAnimationFrame(tickConfetti);
        else confettiRaf = 0;
      }

      function renderFavs() {
        if (!favSection || !favList) return;
        favSection.hidden = favorites.length === 0;
        favList.innerHTML = '';
        favorites.forEach((name, idx) => {
          const li = document.createElement('li');
          li.className = 'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-700 shadow-xs';
          const span = document.createElement('span');
          span.textContent = name;
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.textContent = '×';
          rm.className = 'text-slate-400 hover:text-rose-500 bg-transparent border-0 cursor-pointer text-sm leading-none';
          rm.addEventListener('click', () => {
            favorites.splice(idx, 1);
            try { localStorage.setItem('soodey-baby-shortlist', JSON.stringify(favorites)); } catch {}
            renderFavs();
          });
          li.appendChild(span);
          li.appendChild(rm);
          favList.appendChild(li);
        });
      }

      function displayCurrent() {
        const last = lastNameInput!.value.trim();
        const includeMiddle = middleToggle?.checked ?? true;
        currentFull = [currentFirst, includeMiddle ? currentMiddle : '', last].filter(Boolean).join(' ');
        resultName!.textContent = currentFull;
      }

      function roll() {
        syncUrl();
        const g: 'boy' | 'girl' | 'unisex' =
          lockFirst || lockMiddle
            ? currentGender
            : gender === 'any'
              ? (Math.random() < 0.5 ? 'boy' : 'girl')
              : gender;
        currentGender = g;

        const firstPool = getPool(g, true);
        const middlePool = getPool(g, false);
        const useWeights = tier === 'weighted';

        if (!lockFirst || !currentFirst) {
          currentFirst = pickWeighted(firstPool, useWeights)[0];
        }

        const includeMiddle = middleToggle?.checked ?? true;
        if (includeMiddle && (!lockMiddle || !currentMiddle || currentMiddle === currentFirst)) {
          let tries = 0;
          do {
            currentMiddle = pickWeighted(middlePool, useWeights)[0];
            tries++;
          } while (currentMiddle === currentFirst && tries < 10);
        }

        const fullList = ssa[g];
        const firstRank = fullList.findIndex(([n]) => n === currentFirst) + 1;
        const firstWeight = fullList[firstRank - 1]?.[1] ?? 0;

        const themes = {
          boy: {
            headline: "IT'S A BOY!",
            color: '#2563eb',
            bg: 'linear-gradient(135deg, #8ec5fc 0%, #c2e9fb 52%, #e0c3fc 100%)',
            confetti: ['#2563eb', '#38bdf8', '#60a5fa', '#ffffff', '#facc15'],
          },
          girl: {
            headline: "IT'S A GIRL!",
            color: '#e11d48',
            bg: 'linear-gradient(135deg, #ff9a9e 0%, #fecfef 52%, #fbc2eb 100%)',
            confetti: ['#e11d48', '#f472b6', '#fb7185', '#ffffff', '#fde047'],
          },
          unisex: {
            headline: 'SURPRISE!',
            color: '#7c3aed',
            bg: 'linear-gradient(135deg, #a1c4fd 0%, #e0c3fc 50%, #ffc1e3 100%)',
            confetti: ['#7c3aed', '#38bdf8', '#f472b6', '#facc15', '#ffffff'],
          },
        }[g];

        idleCard!.hidden = true;
        revealCard!.hidden = false;
        document.body.style.background = themes.bg;

        genderHeadline!.textContent = themes.headline;
        genderHeadline!.style.color = themes.color;
        displayCurrent();
        resultName!.style.color = '#1e293b';
        resultMeta!.textContent = firstRank
          ? `Rank #${firstRank} · ${firstWeight.toLocaleString()} US births`
          : '';

        // Trigger joyful pop + gentle wobble animation
        revealCard!.classList.remove('reveal-pop');
        revealInner!.classList.remove('reveal-wobble');
        void revealCard!.offsetWidth;
        revealCard!.classList.add('reveal-pop');
        setTimeout(() => revealInner!.classList.add('reveal-wobble'), 480);

        updateButtons();
        launchConfetti(themes.confetti);
      }

      rollBtn.addEventListener('click', roll);
      rollAgainBtn.addEventListener('click', roll);

      customizeToggle?.addEventListener('click', () => {
        if (!customizePanel) return;
        const open = customizePanel.hidden;
        customizePanel.hidden = !open;
        customizeToggle.setAttribute('aria-expanded', String(open));
      });

      lastNameInput.addEventListener('input', () => {
        syncUrl();
        if (currentFirst) displayCurrent();
      });

      letterSelect.addEventListener('change', () => {
        lockFirst = false;
        syncUrl();
        updateButtons();
      });

      middleToggle?.addEventListener('change', () => {
        if (!middleToggle.checked) lockMiddle = false;
        if (currentFirst) displayCurrent();
        updateButtons();
      });

      lockFirstBtn?.addEventListener('click', () => {
        lockFirst = !lockFirst;
        updateButtons();
      });
      lockMiddleBtn?.addEventListener('click', () => {
        lockMiddle = !lockMiddle;
        updateButtons();
      });

      document.querySelectorAll('.tier-btn').forEach((b) => {
        b.addEventListener('click', () => {
          tier = ((b as HTMLElement).dataset.tier as typeof tier) || 'weighted';
          updateButtons();
          syncUrl();
        });
      });

      document.querySelectorAll('.gender-btn').forEach((b) => {
        b.addEventListener('click', () => {
          gender = ((b as HTMLElement).dataset.gender as typeof gender) || 'any';
          lockFirst = false;
          lockMiddle = false;
          updateButtons();
          syncUrl();
        });
      });

      saveFavBtn?.addEventListener('click', () => {
        if (!currentFull || favorites.includes(currentFull)) return;
        favorites.unshift(currentFull);
        try { localStorage.setItem('soodey-baby-shortlist', JSON.stringify(favorites)); } catch {}
        renderFavs();
      });

      document.getElementById('clearFavsBtn')?.addEventListener('click', () => {
        favorites = [];
        try { localStorage.setItem('soodey-baby-shortlist', '[]'); } catch {}
        renderFavs();
      });

      copyNameBtn?.addEventListener('click', async () => {
        if (!currentFull) return;
        try {
          await navigator.clipboard.writeText(currentFull);
          copyNameBtn.textContent = 'Copied!';
          setTimeout(() => (copyNameBtn.textContent = 'Copy'), 1400);
        } catch {}
      });

      shareLinkBtn?.addEventListener('click', async () => {
        syncUrl();
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLinkBtn.textContent = 'Copied!';
          setTimeout(() => (shareLinkBtn.textContent = 'Share'), 1500);
        } catch {}
      });

      const onKeyDown = (e: KeyboardEvent) => {
        if (e.code === 'Space' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'SELECT') {
          e.preventDefault();
          roll();
        }
      };
      window.addEventListener('keydown', onKeyDown);

      updateButtons();
      renderFavs();

      cleanupBaby = () => {
        cancelAnimationFrame(confettiRaf);
        window.removeEventListener('keydown', onKeyDown);
      };
    }

    document.addEventListener('astro:page-load', initBabyWhimsy);
    document.addEventListener('astro:before-swap', () => {
      cleanupBaby?.();
      cleanupBaby = null;
    });
    initBabyWhimsy();
  </script>
</body>
</html>
