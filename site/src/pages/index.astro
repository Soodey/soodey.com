---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="soodey.com"
  description="soodey.com"
  ogImage="https://soodey.com/recipes/thanksgiving-mac-and-cheese/thanksgiving-mac-and-cheese.jpg"
>
  <main class="relative min-h-[100dvh] w-full overflow-hidden flex flex-col items-center justify-center px-6 select-none">
    <!-- Real-time WebGL Volumetric Fluid / Smoke Shader -->
    <canvas
      id="voidCanvas"
      class="fixed inset-0 w-full h-full pointer-events-none z-0"
      aria-hidden="true"
    ></canvas>

    <!-- Soft atmospheric vignette -->
    <div
      class="fixed inset-0 pointer-events-none z-[1]"
      style="background: radial-gradient(circle at 50% 50%, transparent 18%, rgba(7,7,9,0.68) 80%, rgba(7,7,9,0.96) 100%);"
      aria-hidden="true"
    ></div>

    <!-- Center Stage -->
    <div class="relative z-10 flex flex-col items-center text-center">
      <h1
        id="heroMark"
        class="font-display font-bold tracking-[-0.045em] leading-[0.92] text-bone animate-rise"
        style="font-size: clamp(3.75rem, 13vw, 10rem); text-shadow: 0 20px 80px rgba(0, 0, 0, 0.75);"
      >
        soodey
      </h1>

      <!-- Single Link into Gallery -->
      <div class="mt-10 sm:mt-12 animate-rise" style="animation-delay: 120ms;">
        <a
          id="magneticCta"
          href="/gallery/"
          class="group relative inline-flex items-center gap-3.5 px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] backdrop-blur-xl text-bone hover:border-white/70 hover:bg-bone hover:text-void transition-all duration-300 shadow-[0_12px_40px_rgba(0,0,0,0.6)]"
        >
          <span class="text-sm font-medium tracking-[0.04em]">Enter</span>
          <span class="inline-flex items-center justify-center w-5 h-5 text-sm transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </main>

  <script>
    let cleanupSplash: (() => void) | null = null;

    function initSplash() {
      if (cleanupSplash) {
        cleanupSplash();
        cleanupSplash = null;
      }

      const canvas = document.getElementById('voidCanvas') as HTMLCanvasElement | null;
      if (!canvas) return;

      const magneticCta = document.getElementById('magneticCta') as HTMLElement | null;
      const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5, vx: 0, vy: 0, energy: 0 };

      const onPointerMove = (e: PointerEvent) => {
        const nx = e.clientX / window.innerWidth;
        const ny = 1.0 - e.clientY / window.innerHeight;
        pointer.vx = nx - pointer.tx;
        pointer.vy = ny - pointer.ty;
        pointer.tx = nx;
        pointer.ty = ny;
        pointer.energy = Math.min(1.0, pointer.energy + Math.hypot(pointer.vx, pointer.vy) * 4.5);

        if (magneticCta) {
          const r = magneticCta.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const dist = Math.hypot(dx, dy);
          if (dist < 150) {
            const pull = (1 - dist / 150) * 12;
            magneticCta.style.transform = `translate(${(dx / dist || 0) * pull}px, ${(dy / dist || 0) * pull}px)`;
          } else {
            magneticCta.style.transform = 'translate(0px, 0px)';
          }
        }
      };

      window.addEventListener('pointermove', onPointerMove, { passive: true });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'high-performance' });
      let rafId = 0;

      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.floor(window.innerWidth * dpr);
        canvas.height = Math.floor(window.innerHeight * dpr);
        if (gl) gl.viewport(0, 0, canvas.width, canvas.height);
      };
      resize();
      window.addEventListener('resize', resize);

      if (gl) {
        const vsSrc = `
          attribute vec2 a_pos;
          void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
        `;
        const fsSrc = `
          precision highp float;
          uniform vec2 u_res;
          uniform float u_time;
          uniform vec2 u_mouse;
          uniform float u_energy;

          float hash(vec2 p) {
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
          }

          float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(
              mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
              mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
              u.y
            );
          }

          float fbm(vec2 p) {
            float v = 0.0;
            float a = 0.52;
            mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
            for (int i = 0; i < 6; i++) {
              v += a * noise(p);
              p = rot * p * 2.03 + vec2(1.7, 9.2);
              a *= 0.49;
            }
            return v;
          }

          void main() {
            vec2 p = (gl_FragCoord.xy - 0.5 * u_res.xy) / min(u_res.x, u_res.y);
            vec2 m = (u_mouse - 0.5) * vec2(u_res.x / min(u_res.x, u_res.y), u_res.y / min(u_res.x, u_res.y));

            float t = u_time * 0.12;
            float distMouse = length(p - m);
            float ripple = exp(-distMouse * 2.3) * (0.24 + u_energy * 0.35);

            vec2 q = vec2(
              fbm(p * 1.35 + vec2(t * 0.65, -t * 0.35) + ripple * (p - m)),
              fbm(p * 1.35 + vec2(5.2 - t * 0.45, 1.3 + t * 0.55) - ripple * (p - m))
            );

            vec2 r = vec2(
              fbm(p * 1.6 + 2.5 * q + vec2(1.7, 9.2) + 0.16 * t),
              fbm(p * 1.6 + 2.5 * q + vec2(8.3, 2.8) - 0.14 * t)
            );

            float f = fbm(p * 1.45 + 2.35 * r);

            // Deep obsidian -> silky smoke -> subtle iridescent steel & crimson edge light
            vec3 col = vec3(0.027, 0.027, 0.035);
            col = mix(col, vec3(0.11, 0.115, 0.145), smoothstep(0.24, 0.78, f));
            col = mix(col, vec3(0.24, 0.25, 0.31), smoothstep(0.62, 0.94, f * r.y * 1.45));

            float ribbon = smoothstep(0.66, 0.94, f * length(q) * 1.3);
            vec3 crimson = vec3(0.94, 0.23, 0.31);
            vec3 silver = vec3(0.75, 0.82, 0.95);
            col += mix(silver, crimson, smoothstep(0.25, 0.85, r.x)) * ribbon * (0.38 + ripple * 0.9);

            // Subtle interactive light bloom at cursor
            col += mix(vec3(0.85, 0.24, 0.32), vec3(0.55, 0.65, 0.9), 0.35) * exp(-distMouse * 3.6) * (0.14 + u_energy * 0.18);

            gl_FragColor = vec4(col, 1.0);
          }
        `;

        const compile = (type: number, src: string) => {
          const s = gl.createShader(type)!;
          gl.shaderSource(s, src);
          gl.compileShader(s);
          return s;
        };

        const prog = gl.createProgram()!;
        gl.attachShader(prog, compile(gl.VERTEX_SHADER, vsSrc));
        gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fsSrc));
        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'a_pos');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const uRes = gl.getUniformLocation(prog, 'u_res');
        const uTime = gl.getUniformLocation(prog, 'u_time');
        const uMouse = gl.getUniformLocation(prog, 'u_mouse');
        const uEnergy = gl.getUniformLocation(prog, 'u_energy');

        const start = performance.now();
        const draw = (now: number) => {
          pointer.x += (pointer.tx - pointer.x) * 0.065;
          pointer.y += (pointer.ty - pointer.y) * 0.065;
          pointer.energy *= 0.93;

          gl.uniform2f(uRes, canvas.width, canvas.height);
          gl.uniform1f(uTime, reducedMotion ? 2.0 : (now - start) * 0.001);
          gl.uniform2f(uMouse, pointer.x, pointer.y);
          gl.uniform1f(uEnergy, pointer.energy);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

          if (!reducedMotion) {
            rafId = requestAnimationFrame(draw);
          }
        };
        rafId = requestAnimationFrame(draw);
      }

      cleanupSplash = () => {
        cancelAnimationFrame(rafId);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', resize);
      };
    }

    document.addEventListener('astro:page-load', initSplash);
    document.addEventListener('astro:before-swap', () => {
      cleanupSplash?.();
      cleanupSplash = null;
    });
    initSplash();
  </script>
</BaseLayout>
