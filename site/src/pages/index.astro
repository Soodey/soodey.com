---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SOODEY"
  description="soodey.com — an anthology of jokes, tools, toys, and useful oddities."
  ogImage="https://soodey.com/recipes/thanksgiving-mac-and-cheese/thanksgiving-mac-and-cheese.jpg"
>
  <main class="relative min-h-[100dvh] w-full overflow-hidden flex flex-col items-center justify-center px-6 select-none">
    <!-- Real-time WebGL Volumetric Smoke / Void Shader Canvas -->
    <canvas
      id="voidCanvas"
      class="fixed inset-0 w-full h-full pointer-events-none z-0"
      aria-hidden="true"
    ></canvas>

    <!-- Subtle radial vignette -->
    <div
      class="fixed inset-0 pointer-events-none z-[1]"
      style="background: radial-gradient(circle at 50% 50%, transparent 25%, rgba(6,6,7,0.72) 85%, rgba(6,6,7,0.96) 100%);"
      aria-hidden="true"
    ></div>

    <!-- Subtle corner telemetry frame (purely atmospheric, zero clutter) -->
    <div class="fixed top-6 left-6 right-6 z-10 flex items-center justify-between pointer-events-none font-mono text-[11px] tracking-[0.22em] text-white/35 uppercase">
      <span class="inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-crimson shadow-[0_0_10px_#ff2244] animate-pulse"></span>
        <span>SOODEY.COM</span>
      </span>
      <span id="coordReadout" class="hidden sm:inline tabular-nums">00.00 // 00.00</span>
    </div>

    <!-- Center Anthology Stage -->
    <div class="relative z-10 flex flex-col items-center text-center max-w-4xl">
      <!-- Love, Death + Robots inspired 3-glyph morphing sigil -->
      <button
        id="sigilBar"
        type="button"
        title="Cycle glyphs"
        aria-label="Cycle anthology glyphs"
        class="mb-8 flex items-center gap-6 sm:gap-9 text-crimson cursor-pointer group focus:outline-none"
      >
        <span class="glyph-slot w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110" data-slot="0"></span>
        <span class="w-4 h-[1.5px] bg-white/20"></span>
        <span class="glyph-slot w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110" data-slot="1"></span>
        <span class="w-4 h-[1.5px] bg-white/20"></span>
        <span class="glyph-slot w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110" data-slot="2"></span>
      </button>

      <!-- Monolithic Display Wordmark -->
      <h1
        id="heroMark"
        data-text="SOODEY"
        class="glitch-mark font-display font-extrabold tracking-[-0.04em] leading-[0.88] text-bone uppercase cursor-default"
        style="font-size: clamp(3.6rem, 13.5vw, 10.5rem);"
      >
        SOODEY
      </h1>

      <!-- The ONLY Link on the Homepage -->
      <div class="mt-12 sm:mt-14">
        <a
          id="magneticCta"
          href="/gallery/"
          class="group relative inline-flex items-center gap-4 px-8 py-4 rounded-full border border-white/20 bg-white/[0.04] backdrop-blur-md text-bone hover:border-crimson hover:bg-crimson hover:text-white transition-all duration-300 shadow-[0_0_40px_rgba(0,0,0,0.6)] hover:shadow-[0_0_50px_rgba(255,34,68,0.45)]"
        >
          <span class="font-mono text-xs sm:text-sm font-semibold tracking-[0.26em] uppercase">Enter Gallery</span>
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full border border-current text-xs transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <!-- Bottom hairline index mark -->
    <div class="fixed bottom-6 left-6 right-6 z-10 flex items-center justify-between pointer-events-none font-mono text-[10px] tracking-[0.24em] text-white/25 uppercase">
      <span>VOL. XXVI</span>
      <span>MOVE CURSOR // CLICK GLYPHS</span>
    </div>
  </main>

  <script>
    // Love, Death + Robots inspired geometric SVG glyphs
    const GLYPHS = [
      // Heart
      `<svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M16 28.5L13.8 26.5C6.1 19.6 2 15.8 2 10.7C2 6.5 5.3 3.2 9.5 3.2C11.9 3.2 14.3 4.3 16 6.1C17.7 4.3 20.1 3.2 22.5 3.2C26.7 3.2 30 6.5 30 10.7C30 15.8 25.9 19.6 18.2 26.5L16 28.5Z"/></svg>`,
      // Bold X (Death)
      `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="square" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M6 6L26 26M26 6L6 26"/></svg>`,
      // Geometric Bot Head
      `<svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5 2H17.5V6H26C27.1 6 28 6.9 28 8V25C28 26.1 27.1 27 26 27H6C4.9 27 4 26.1 4 25V8C4 6.9 4.9 6 6 6H14.5V2ZM11.5 14C10.1 14 9 15.1 9 16.5C9 17.9 10.1 19 11.5 19C12.9 19 14 17.9 14 16.5C14 15.1 12.9 14 11.5 14ZM20.5 14C19.1 14 18 15.1 18 16.5C18 17.9 19.1 19 20.5 19C21.9 19 23 17.9 23 16.5C23 15.1 21.9 14 20.5 14Z"/></svg>`,
      // Eye
      `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M2 16C5.8 9.2 10.5 6 16 6C21.5 6 26.2 9.2 30 16C26.2 22.8 21.5 26 16 26C10.5 26 5.8 22.8 2 16Z"/><circle cx="16" cy="16" r="4.5" fill="currentColor"/></svg>`,
      // Bolt
      `<svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M18.5 2L5 18H15L13.5 30L27 14H17L18.5 2Z"/></svg>`,
      // Fork / Knife / Flame
      `<svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M16.8 2.5C17.2 8.2 11 10.4 11 16.5C11 19.5 13.2 22 16 22C18.8 22 21 19.8 21 17C21 14.8 19.8 13.1 18.8 11.8C22.4 12.8 25 16.2 25 20.3C25 25.4 20.9 29.5 15.8 29.5C10.7 29.5 6.8 25.4 6.8 20.3C6.8 13.8 12.2 8.5 16.8 2.5Z"/></svg>`,
      // Diamond Target
      `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" class="w-full h-full drop-shadow-[0_0_12px_rgba(255,34,68,0.55)]"><path d="M16 3L29 16L16 29L3 16L16 3Z"/><rect x="13" y="13" width="6" height="6" fill="currentColor"/></svg>`,
    ];

    let cleanupSplash: (() => void) | null = null;

    function initSplash() {
      if (cleanupSplash) {
        cleanupSplash();
        cleanupSplash = null;
      }

      const canvas = document.getElementById('voidCanvas') as HTMLCanvasElement | null;
      if (!canvas) return;

      const slots = Array.from(document.querySelectorAll('.glyph-slot'));
      const sigilBar = document.getElementById('sigilBar');
      const heroMark = document.getElementById('heroMark');
      const coordReadout = document.getElementById('coordReadout');
      const magneticCta = document.getElementById('magneticCta') as HTMLElement | null;

      let glyphState = [0, 1, 2];
      const renderGlyphs = () => {
        slots.forEach((slot, i) => {
          slot.innerHTML = GLYPHS[glyphState[i] % GLYPHS.length];
        });
      };

      const spinGlyphs = () => {
        if (heroMark) {
          heroMark.classList.add('is-glitching');
          setTimeout(() => heroMark.classList.remove('is-glitching'), 180);
        }
        let ticks = 0;
        const iv = window.setInterval(() => {
          glyphState = glyphState.map(() => Math.floor(Math.random() * GLYPHS.length));
          renderGlyphs();
          ticks++;
          if (ticks >= 7) {
            clearInterval(iv);
            // Ensure 3 distinct glyphs
            const pool = [...Array(GLYPHS.length).keys()].sort(() => Math.random() - 0.5);
            glyphState = pool.slice(0, 3);
            renderGlyphs();
          }
        }, 42);
      };

      renderGlyphs();
      sigilBar?.addEventListener('click', spinGlyphs);

      // Periodic subtle glitch pulse
      const glitchTimer = window.setInterval(() => {
        if (!heroMark || Math.random() > 0.35) return;
        heroMark.classList.add('is-glitching');
        setTimeout(() => heroMark.classList.remove('is-glitching'), 120);
      }, 4200);

      // Pointer tracking for shader + magnetic CTA
      const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5, energy: 0 };
      const onPointerMove = (e: PointerEvent) => {
        pointer.tx = e.clientX / window.innerWidth;
        pointer.ty = 1.0 - e.clientY / window.innerHeight;
        pointer.energy = Math.min(1.0, pointer.energy + 0.16);

        if (coordReadout) {
          const cx = (e.clientX / window.innerWidth * 100).toFixed(2).padStart(5, '0');
          const cy = (e.clientY / window.innerHeight * 100).toFixed(2).padStart(5, '0');
          coordReadout.textContent = `${cx} // ${cy}`;
        }

        if (magneticCta) {
          const r = magneticCta.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const dist = Math.hypot(dx, dy);
          if (dist < 160) {
            const pull = (1 - dist / 160) * 14;
            magneticCta.style.transform = `translate(${(dx / dist || 0) * pull}px, ${(dy / dist || 0) * pull}px)`;
          } else {
            magneticCta.style.transform = 'translate(0px, 0px)';
          }
        }
      };

      window.addEventListener('pointermove', onPointerMove, { passive: true });

      // WebGL Domain-Warped Dark Smoke + Crimson Ember Shader
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'high-performance' });
      let rafId = 0;

      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.floor(window.innerWidth * dpr);
        canvas.height = Math.floor(window.innerHeight * dpr);
        if (gl) gl.viewport(0, 0, canvas.width, canvas.height);
      };
      resize();
      window.addEventListener('resize', resize);

      if (gl) {
        const vsSrc = `
          attribute vec2 a_pos;
          void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
        `;
        const fsSrc = `
          precision mediump float;
          uniform vec2 u_res;
          uniform float u_time;
          uniform vec2 u_mouse;
          uniform float u_energy;

          float hash(vec2 p) {
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
          }

          float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(
              mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
              mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
              u.y
            );
          }

          float fbm(vec2 p) {
            float v = 0.0;
            float a = 0.52;
            mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
            for (int i = 0; i < 5; i++) {
              v += a * noise(p);
              p = rot * p * 2.02 + vec2(1.7, 9.2);
              a *= 0.5;
            }
            return v;
          }

          void main() {
            vec2 uv = gl_FragCoord.xy / u_res.xy;
            vec2 p = (gl_FragCoord.xy - 0.5 * u_res.xy) / min(u_res.x, u_res.y);
            vec2 m = (u_mouse - 0.5) * vec2(u_res.x / min(u_res.x, u_res.y), u_res.y / min(u_res.x, u_res.y));

            float t = u_time * 0.14;
            float distMouse = length(p - m);
            float mouseWarp = exp(-distMouse * 2.4) * (0.28 + u_energy * 0.35);

            vec2 q = vec2(
              fbm(p * 1.45 + vec2(t * 0.7, -t * 0.4) + mouseWarp),
              fbm(p * 1.45 + vec2(5.2 - t * 0.5, 1.3 + t * 0.6) - mouseWarp)
            );

            vec2 r = vec2(
              fbm(p * 1.7 + 2.6 * q + vec2(1.7, 9.2) + 0.18 * t),
              fbm(p * 1.7 + 2.6 * q + vec2(8.3, 2.8) - 0.15 * t)
            );

            float f = fbm(p * 1.5 + 2.4 * r);

            // Obsidian base -> charcoal smoke -> electric LD+R crimson veins
            vec3 col = vec3(0.023, 0.023, 0.028);
            col = mix(col, vec3(0.09, 0.085, 0.105), smoothstep(0.22, 0.75, f));

            // Razor crimson energy filaments
            float vein = smoothstep(0.64, 0.92, f * length(q) * 1.35);
            vec3 crimson = vec3(1.0, 0.12, 0.25);
            vec3 ember = vec3(1.0, 0.45, 0.14);
            col += mix(crimson, ember, smoothstep(0.3, 0.9, r.x)) * vein * (0.52 + mouseWarp * 1.25);

            // Soft cursor aura
            col += vec3(0.95, 0.14, 0.27) * exp(-distMouse * 3.8) * (0.14 + u_energy * 0.16);

            // Subtle horizontal scanlines
            float scan = sin(gl_FragCoord.y * 1.5) * 0.012;
            col -= scan;

            gl_FragColor = vec4(col, 1.0);
          }
        `;

        const compile = (type: number, src: string) => {
          const s = gl.createShader(type)!;
          gl.shaderSource(s, src);
          gl.compileShader(s);
          return s;
        };

        const prog = gl.createProgram()!;
        gl.attachShader(prog, compile(gl.VERTEX_SHADER, vsSrc));
        gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fsSrc));
        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'a_pos');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const uRes = gl.getUniformLocation(prog, 'u_res');
        const uTime = gl.getUniformLocation(prog, 'u_time');
        const uMouse = gl.getUniformLocation(prog, 'u_mouse');
        const uEnergy = gl.getUniformLocation(prog, 'u_energy');

        const start = performance.now();
        const draw = (now: number) => {
          pointer.x += (pointer.tx - pointer.x) * 0.06;
          pointer.y += (pointer.ty - pointer.y) * 0.06;
          pointer.energy *= 0.94;

          gl.uniform2f(uRes, canvas.width, canvas.height);
          gl.uniform1f(uTime, reducedMotion ? 1.5 : (now - start) * 0.001);
          gl.uniform2f(uMouse, pointer.x, pointer.y);
          gl.uniform1f(uEnergy, pointer.energy);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

          if (!reducedMotion) {
            rafId = requestAnimationFrame(draw);
          }
        };
        rafId = requestAnimationFrame(draw);
      }

      cleanupSplash = () => {
        cancelAnimationFrame(rafId);
        clearInterval(glitchTimer);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', resize);
        sigilBar?.removeEventListener('click', spinGlyphs);
      };
    }

    document.addEventListener('astro:page-load', initSplash);
    document.addEventListener('astro:before-swap', () => {
      if (cleanupSplash) {
        cleanupSplash();
        cleanupSplash = null;
      }
    });
    initSplash();
  </script>
</BaseLayout>
