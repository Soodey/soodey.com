---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — soodey.com" description="Page not found." noindex={true}>
  <main class="min-h-[100dvh] void-grid flex flex-col items-center justify-center px-6 text-center">
    <div class="space-y-5 max-w-sm animate-rise">
      <div class="font-display font-bold text-7xl sm:text-8xl tracking-[-0.04em] leading-none text-bone">
        404
      </div>
      <p class="text-sm text-ash m-0">
        Page not found.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/gallery/"
          class="px-5 py-2.5 rounded-full bg-bone text-void text-xs font-semibold hover:opacity-90 transition"
        >
          Gallery →
        </a>
        <a
          href="/"
          class="px-5 py-2.5 rounded-full border border-white/15 hover:border-white/40 text-bone text-xs font-medium transition"
        >
          Home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
