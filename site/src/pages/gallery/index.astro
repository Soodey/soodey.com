---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GALLERY_ITEMS } from '../../data/gallery';

const counts = {
  all: GALLERY_ITEMS.length,
  tools: GALLERY_ITEMS.filter((i) => i.category === 'tools').length,
  toys: GALLERY_ITEMS.filter((i) => i.category === 'toys').length,
  kitchen: GALLERY_ITEMS.filter((i) => i.category === 'kitchen').length,
};
---

<BaseLayout
  title="Gallery // SOODEY"
  description="Curated archive of soodey.com tools, toys, jokes, and recipes."
  showNav={true}
  backHref="/"
  backLabel="Splash"
  navSection="Gallery"
>
  <main class="min-h-[calc(100dvh-4rem)] void-grid">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-10 pb-24 space-y-10">
      <!-- Header & Filter Bar (a1.gallery clean curated bar) -->
      <section class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/[0.08] animate-rise">
        <div class="space-y-2">
          <div class="font-mono text-[11px] uppercase tracking-[0.24em] text-crimson flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-crimson"></span>
            <span>Curated Index · {counts.all} Entries</span>
          </div>
          <h1 class="font-display font-extrabold text-4xl sm:text-6xl tracking-[-0.03em] text-bone leading-none">
            THE GALLERY
          </h1>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter gallery">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-filter="all"
            class="filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-bone text-void border-bone font-semibold"
          >
            All <span class="opacity-60 ml-1">{counts.all}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="tools"
            class="filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Tools <span class="opacity-60 ml-1">{counts.tools}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="toys"
            class="filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Toys &amp; Jokes <span class="opacity-60 ml-1">{counts.toys}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="kitchen"
            class="filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Kitchen <span class="opacity-60 ml-1">{counts.kitchen}</span>
          </button>
        </div>
      </section>

      <!-- Curated Grid -->
      <section
        id="galleryGrid"
        class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
        aria-label="Gallery entries"
      >
        {GALLERY_ITEMS.map((item, idx) => (
          <a
            href={item.href}
            data-category={item.category}
            class="gallery-item kinetic-card group flex flex-col rounded-2xl bg-surface border border-white/[0.09] animate-rise"
            style={`animation-delay: ${idx * 65}ms;`}
          >
            <!-- Visual Preview Stage (16:10 a1.gallery aspect ratio) -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#09090c] border-b border-white/[0.07]">
              {item.preview === 'kitchen' && item.image && (
                <>
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
                </>
              )}

              {item.preview === 'meme' && (
                <div class="w-full h-full p-5 flex items-center justify-center bg-[radial-gradient(circle_at_75%_20%,rgba(29,161,242,0.18),transparent_55%),#0b0f14]">
                  <div class="w-full max-w-[290px] rounded-xl bg-[#15202b] border border-white/12 p-3.5 shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04] group-hover:-rotate-[0.8deg]">
                    <div class="flex items-center gap-2.5 mb-2">
                      <img src="/please_god/tim-pool-pfp.jpg" alt="" class="w-8 h-8 rounded-full object-cover border border-white/15" />
                      <div class="leading-tight">
                        <div class="text-xs font-bold text-white flex items-center gap-1">
                          <span>Tim Pool</span>
                          <span class="inline-block w-3 h-3 rounded-full bg-[#1d9bf0] text-[8px] text-white text-center leading-3">✓</span>
                        </div>
                        <div class="text-[10px] text-[#8b98a5]">@Timcast · 1h</div>
                      </div>
                    </div>
                    <p class="text-xs text-white/95 leading-snug font-sans m-0">
                      Source tells me <span class="text-[#1da1f2]">[anything]</span>.<br /><br />Please god
                    </p>
                  </div>
                </div>
              )}

              {item.preview === 'dvd' && (
                <div class="relative w-full h-full bg-[#07070a] overflow-hidden">
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,34,68,0.09),transparent_70%)]"></div>
                  <div class="mini-dvd absolute px-3.5 py-1.5 rounded-md border-2 border-crimson text-crimson font-display font-extrabold text-lg tracking-wider shadow-[0_0_24px_rgba(255,34,68,0.4)]">
                    DVD
                  </div>
                  <div class="absolute bottom-3 left-3 font-mono text-[10px] text-white/40 tracking-widest">
                    CORNER HITS // LIVE PHYSICS
                  </div>
                </div>
              )}

              {item.preview === 'clock' && (
                <div class="w-full h-full flex items-center justify-center bg-[radial-gradient(circle_at_50%_50%,rgba(255,34,68,0.1),transparent_68%),#08080b]">
                  <svg viewBox="0 0 120 120" class="w-32 h-32 transition-transform duration-500 group-hover:scale-105" aria-hidden="true">
                    <circle cx="60" cy="60" r="52" fill="#0d0d11" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" />
                    <circle cx="60" cy="60" r="46" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="2 10.05" />
                    <line id="miniHour" x1="60" y1="60" x2="60" y2="33" stroke="#f4f3ef" stroke-width="3.2" stroke-linecap="round" />
                    <line id="miniMin" x1="60" y1="60" x2="60" y2="22" stroke="#f4f3ef" stroke-width="2" stroke-linecap="round" />
                    <line id="miniSec" x1="60" y1="68" x2="60" y2="18" stroke="#ff2244" stroke-width="1.4" stroke-linecap="round" />
                    <circle cx="60" cy="60" r="3.2" fill="#ff2244" />
                  </svg>
                </div>
              )}

              {item.preview === 'ascii' && (
                <div class="w-full h-full p-4 flex items-center justify-center bg-[#060807] overflow-hidden">
                  <pre class="font-mono text-[8.5px] leading-[1.08] text-crimson/80 group-hover:text-crimson transition-colors select-none m-0">{`       ..::::::..
    .:++========++:.
  .:+==++******++==+:.
 .==+*#%%@@@@@@%%#*+==.
 :=*#%@@@##**##@@@%#*=
 :=#%@@#=:    :=#@@%#=:
 .=*#%@%-  ::  -%@%#*=.
  :++*#%@%#**#%@%#*++:
   .:==+*######*+==:.
      ..::====::..`}</pre>
                </div>
              )}

              {item.preview === 'hero' && (
                <div class="w-full h-full p-5 flex flex-col items-center justify-center gap-2 bg-[radial-gradient(circle_at_50%_30%,rgba(255,34,68,0.22),rgba(124,58,237,0.14),transparent_72%),#09090d] text-center">
                  <div class="font-mono text-[10px] tracking-[0.25em] uppercase text-crimson">ROULETTE ENGINE</div>
                  <div class="font-display font-extrabold text-xl sm:text-2xl text-bone tracking-tight transition-transform duration-500 group-hover:scale-105">
                    "Lord of Avernus"
                  </div>
                  <div class="flex items-center gap-1.5 pt-1">
                    <span class="px-2 py-0.5 rounded-full bg-white/8 text-[10px] font-mono text-ash">SSA Weighted</span>
                    <span class="px-2 py-0.5 rounded-full bg-crimson/20 text-[10px] font-mono text-crimson">Dota Lore</span>
                    <span class="px-2 py-0.5 rounded-full bg-white/8 text-[10px] font-mono text-ash">Chaos</span>
                  </div>
                </div>
              )}

              {item.preview === 'storm' && (
                <div class="relative w-full h-full flex items-center justify-center bg-[radial-gradient(circle_at_60%_20%,rgba(255,34,68,0.28),transparent_58%),#050508] overflow-hidden">
                  <svg viewBox="0 0 220 140" class="w-full h-full" aria-hidden="true">
                    <path d="M132 0 L114 48 L128 52 L102 104 L112 106 L94 140" fill="none" stroke="#ff2244" stroke-width="3.5" stroke-linecap="round" opacity="0.9" />
                    <path d="M132 0 L114 48 L128 52 L102 104 L112 106 L94 140" fill="none" stroke="#fff1f2" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M114 48 L88 76 M102 104 L132 126" fill="none" stroke="#ff2244" stroke-width="1.5" opacity="0.7" />
                  </svg>
                  <span class="absolute bottom-3 left-3 font-mono text-[10px] tracking-[0.22em] text-white/50">UNSPEAKABLE EVIL</span>
                </div>
              )}

              <!-- Top Episode & Year Overlay Badges -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none z-10">
                <span class="px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/12 font-mono text-[10px] font-bold tracking-[0.18em] text-bone">
                  EP.{item.episode}
                </span>
                <span class="px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/12 font-mono text-[10px] tracking-[0.12em] text-ash">
                  {item.categoryLabel}
                </span>
              </div>
            </div>

            <!-- Card Metadata Body -->
            <div class="relative z-[3] p-5 flex-1 flex flex-col justify-between gap-4">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between gap-3">
                  <h2 class="font-display font-bold text-xl tracking-tight text-bone group-hover:text-white transition">
                    {item.title}
                  </h2>
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full border border-white/12 text-xs text-ash group-hover:border-crimson group-hover:bg-crimson group-hover:text-white transition-all duration-300 shrink-0">
                    ↗
                  </span>
                </div>
                <p class="text-sm text-ash leading-relaxed m-0">
                  {item.subtitle}
                </p>
              </div>

              <div class="flex items-center justify-between pt-3.5 border-t border-white/[0.07] font-mono text-[11px] text-white/40">
                <span>{item.tag}</span>
                <span>{item.year}</span>
              </div>
            </div>
          </a>
        ))}
      </section>

      <!-- Quiet Footer -->
      <footer class="pt-8 border-t border-white/[0.07] flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-white/35">
        <span>SOODEY.COM // ASTRO + TAILWIND V4</span>
        <span>MORE COMING WHENEVER A DUMB IDEA STRIKES</span>
      </footer>
    </div>
  </main>

  <script>
    let galleryCleanup: (() => void) | null = null;

    function initGallery() {
      if (galleryCleanup) {
        galleryCleanup();
        galleryCleanup = null;
      }

      const pills = Array.from(document.querySelectorAll('.filter-pill')) as HTMLButtonElement[];
      const items = Array.from(document.querySelectorAll('.gallery-item')) as HTMLElement[];

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.filter || 'all';
          pills.forEach((p) => {
            const active = p === pill;
            p.setAttribute('aria-selected', String(active));
            p.className = active
              ? 'filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-bone text-void border-bone font-semibold'
              : 'filter-pill px-4 py-2 rounded-full border text-xs font-mono uppercase tracking-[0.14em] cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone';
          });

          items.forEach((card) => {
            const match = filter === 'all' || card.dataset.category === filter;
            card.style.display = match ? '' : 'none';
          });
        });
      });

      // Live mini animations for the DVD & Clock preview cards
      const miniDvd = document.querySelector('.mini-dvd') as HTMLElement | null;
      const miniHour = document.getElementById('miniHour');
      const miniMin = document.getElementById('miniMin');
      const miniSec = document.getElementById('miniSec');

      const colors = ['#ff2244', '#22d3ee', '#f59e0b', '#a855f7', '#10b981'];
      let colorIdx = 0;
      let dx = 1.15;
      let dy = 0.85;
      let x = 24;
      let y = 24;
      let rafId = 0;

      const tick = () => {
        if (miniDvd && miniDvd.parentElement) {
          const pw = miniDvd.parentElement.clientWidth;
          const ph = miniDvd.parentElement.clientHeight;
          const cw = miniDvd.offsetWidth || 68;
          const ch = miniDvd.offsetHeight || 34;

          x += dx;
          y += dy;
          let hit = false;
          if (x <= 8 || x + cw >= pw - 8) {
            dx = -dx;
            x = Math.max(8, Math.min(pw - cw - 8, x));
            hit = true;
          }
          if (y <= 34 || y + ch >= ph - 26) {
            dy = -dy;
            y = Math.max(34, Math.min(ph - ch - 26, y));
            hit = true;
          }
          if (hit) {
            colorIdx = (colorIdx + 1) % colors.length;
            const c = colors[colorIdx];
            miniDvd.style.borderColor = c;
            miniDvd.style.color = c;
            miniDvd.style.boxShadow = `0 0 24px ${c}66`;
          }
          miniDvd.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        }

        if (miniHour && miniMin && miniSec) {
          const now = new Date();
          const sec = now.getSeconds() + now.getMilliseconds() / 1000;
          const min = now.getMinutes() + sec / 60;
          const hr = (now.getHours() % 12) + min / 60;
          miniSec.setAttribute('transform', `rotate(${sec * 6} 60 60)`);
          miniMin.setAttribute('transform', `rotate(${min * 6} 60 60)`);
          miniHour.setAttribute('transform', `rotate(${hr * 30} 60 60)`);
        }

        rafId = requestAnimationFrame(tick);
      };

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        rafId = requestAnimationFrame(tick);
      }

      galleryCleanup = () => cancelAnimationFrame(rafId);
    }

    document.addEventListener('astro:page-load', initGallery);
    document.addEventListener('astro:before-swap', () => {
      if (galleryCleanup) {
        galleryCleanup();
        galleryCleanup = null;
      }
    });
    initGallery();
  </script>
</BaseLayout>
