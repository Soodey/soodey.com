---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GALLERY_ITEMS } from '../../data/gallery';

const counts = {
  all: GALLERY_ITEMS.length,
  tools: GALLERY_ITEMS.filter((i) => i.category === 'tools').length,
  toys: GALLERY_ITEMS.filter((i) => i.category === 'toys').length,
  kitchen: GALLERY_ITEMS.filter((i) => i.category === 'kitchen').length,
};
---

<BaseLayout
  title="Gallery — soodey.com"
  description="Tools, toys, and recipes on soodey.com."
  showNav={true}
  backHref="/"
  backLabel="Home"
  navSection="Gallery"
>
  <main class="min-h-[calc(100dvh-4rem)] void-grid">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-10 pb-24 space-y-10">
      <!-- Clean a1.gallery-style Header & Filter Bar -->
      <section class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-8 border-b border-white/[0.08] animate-rise">
        <h1 class="font-display font-bold text-4xl sm:text-5xl tracking-[-0.035em] text-bone leading-none m-0">
          Gallery
        </h1>

        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter gallery">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-filter="all"
            class="filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-bone text-void border-bone"
          >
            All <span class="opacity-55 ml-1 font-mono">{counts.all}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="tools"
            class="filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Tools <span class="opacity-55 ml-1 font-mono">{counts.tools}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="toys"
            class="filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Toys <span class="opacity-55 ml-1 font-mono">{counts.toys}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="kitchen"
            class="filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone"
          >
            Kitchen <span class="opacity-55 ml-1 font-mono">{counts.kitchen}</span>
          </button>
        </div>
      </section>

      <!-- Curated Visual Grid -->
      <section
        id="galleryGrid"
        class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
        aria-label="Gallery items"
      >
        {GALLERY_ITEMS.map((item, idx) => (
          <a
            href={item.href}
            data-category={item.category}
            class="gallery-item kinetic-card group flex flex-col rounded-2xl bg-surface border border-white/[0.08] animate-rise"
            style={`animation-delay: ${idx * 55}ms;`}
          >
            <!-- 16:10 Visual Preview Stage -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#0a0a0e] border-b border-white/[0.07]">
              {item.preview === 'kitchen' && item.image && (
                <>
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
                </>
              )}

              {item.preview === 'baby' && (
                <div class="w-full h-full p-6 flex items-center justify-center" style="background: linear-gradient(135deg, #a1c4fd 0%, #e0c3fc 50%, #ffc1e3 100%);">
                  <div class="rounded-2xl bg-white/88 backdrop-blur-md px-6 py-4 text-center shadow-lg transition-transform duration-500 group-hover:scale-105">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-indigo-500">Baby Name Picker</div>
                    <div class="font-display font-bold text-xl text-slate-800 mt-0.5">Oliver James</div>
                    <div class="inline-block mt-2 px-3 py-1 rounded-lg text-[11px] font-bold text-white" style="background: linear-gradient(135deg, #5e72e4, #825ee4);">New Baby!</div>
                  </div>
                </div>
              )}

              {item.preview === 'meme' && (
                <div class="w-full h-full p-5 flex items-center justify-center bg-[radial-gradient(circle_at_75%_20%,rgba(29,161,242,0.16),transparent_55%),#0b0f14]">
                  <div class="w-full max-w-[290px] rounded-xl bg-[#15202b] border border-white/12 p-3.5 shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]">
                    <div class="flex items-center gap-2.5 mb-2">
                      <img src="/please_god/tim-pool-pfp.jpg" alt="" class="w-8 h-8 rounded-full object-cover border border-white/15" />
                      <div class="leading-tight">
                        <div class="text-xs font-bold text-white flex items-center gap-1">
                          <span>Tim Pool</span>
                          <span class="inline-block w-3 h-3 rounded-full bg-[#1d9bf0] text-[8px] text-white text-center leading-3">✓</span>
                        </div>
                        <div class="text-[10px] text-[#8b98a5]">@Timcast · 1h</div>
                      </div>
                    </div>
                    <p class="text-xs text-white/95 leading-snug font-sans m-0">
                      Source tells me <span class="text-[#1da1f2]">Charlie is stable</span>.<br /><br />Please god
                    </p>
                  </div>
                </div>
              )}

              {item.preview === 'dvd' && (
                <div class="relative w-full h-full bg-[#08080b] overflow-hidden">
                  <div class="mini-dvd absolute px-3.5 py-1 rounded-md border-2 border-crimson text-crimson font-display font-bold text-lg tracking-wider shadow-[0_0_24px_rgba(239,59,78,0.35)]">
                    DVD
                  </div>
                </div>
              )}

              {item.preview === 'clock' && (
                <div class="w-full h-full flex items-center justify-center bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.05),transparent_68%),#09090d]">
                  <svg viewBox="0 0 120 120" class="w-32 h-32 transition-transform duration-500 group-hover:scale-105" aria-hidden="true">
                    <circle cx="60" cy="60" r="52" fill="#0e0e12" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" />
                    <circle cx="60" cy="60" r="46" fill="none" stroke="rgba(255,255,255,0.09)" stroke-width="1" stroke-dasharray="2 10.05" />
                    <line id="miniHour" x1="60" y1="60" x2="60" y2="33" stroke="#f5f5f7" stroke-width="3.2" stroke-linecap="round" />
                    <line id="miniMin" x1="60" y1="60" x2="60" y2="22" stroke="#f5f5f7" stroke-width="2" stroke-linecap="round" />
                    <line id="miniSec" x1="60" y1="68" x2="60" y2="18" stroke="#ef3b4e" stroke-width="1.4" stroke-linecap="round" />
                    <circle cx="60" cy="60" r="3" fill="#ef3b4e" />
                  </svg>
                </div>
              )}

              {item.preview === 'ascii' && (
                <div class="w-full h-full p-4 flex items-center justify-center bg-[#07090b] overflow-hidden">
                  <pre class="font-mono text-[8.5px] leading-[1.08] text-bone/70 group-hover:text-bone transition-colors select-none m-0">{`       ..::::::..
    .:++========++:.
  .:+==++******++==+:.
 .==+*#%%@@@@@@%%#*+==.
 :=*#%@@@##**##@@@%#*=
 :=#%@@#=:    :=#@@%#=:
 .=*#%@%-  ::  -%@%#*=.
  :++*#%@%#**#%@%#*++:
   .:==+*######*+==:.
      ..::====::..`}</pre>
                </div>
              )}

              {item.preview === 'storm' && (
                <div class="relative w-full h-full flex items-center justify-center bg-[#040508] overflow-hidden">
                  {item.image && (
                    <img
                      src={item.image}
                      alt=""
                      class="absolute inset-0 w-full h-full object-cover object-top opacity-35 group-hover:opacity-60 grayscale contrast-125 transition duration-500"
                    />
                  )}
                  <svg viewBox="0 0 220 140" class="relative z-10 w-full h-full" aria-hidden="true">
                    <path d="M132 0 L114 48 L128 52 L102 104 L112 106 L94 140" fill="none" stroke="#60a5fa" stroke-width="3.5" stroke-linecap="round" opacity="0.85" />
                    <path d="M132 0 L114 48 L128 52 L102 104 L112 106 L94 140" fill="none" stroke="#f0f9ff" stroke-width="1.2" stroke-linecap="round" />
                    <path d="M114 48 L88 76 M102 104 L132 126" fill="none" stroke="#60a5fa" stroke-width="1.4" opacity="0.65" />
                  </svg>
                </div>
              )}
            </div>

            <!-- Card Metadata -->
            <div class="relative z-[3] p-5 flex-1 flex flex-col justify-between gap-3">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between gap-3">
                  <h2 class="font-display font-semibold text-lg tracking-[-0.015em] text-bone group-hover:text-white transition m-0">
                    {item.title}
                  </h2>
                  <span class="px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/10 text-[11px] text-ash shrink-0">
                    {item.categoryLabel}
                  </span>
                </div>
                <p class="text-sm text-ash leading-relaxed m-0">
                  {item.subtitle}
                </p>
              </div>
            </div>
          </a>
        ))}
      </section>
    </div>
  </main>

  <script>
    let galleryCleanup: (() => void) | null = null;

    function initGallery() {
      if (galleryCleanup) {
        galleryCleanup();
        galleryCleanup = null;
      }

      const pills = Array.from(document.querySelectorAll('.filter-pill')) as HTMLButtonElement[];
      const items = Array.from(document.querySelectorAll('.gallery-item')) as HTMLElement[];

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.filter || 'all';
          pills.forEach((p) => {
            const active = p === pill;
            p.setAttribute('aria-selected', String(active));
            p.className = active
              ? 'filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-bone text-void border-bone'
              : 'filter-pill px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition bg-white/[0.03] text-ash border-white/12 hover:border-white/30 hover:text-bone';
          });

          items.forEach((card) => {
            const match = filter === 'all' || card.dataset.category === filter;
            card.style.display = match ? '' : 'none';
          });
        });
      });

      const miniDvd = document.querySelector('.mini-dvd') as HTMLElement | null;
      const miniHour = document.getElementById('miniHour');
      const miniMin = document.getElementById('miniMin');
      const miniSec = document.getElementById('miniSec');

      const colors = ['#ef3b4e', '#38bdf8', '#f59e0b', '#a855f7', '#10b981'];
      let colorIdx = 0;
      let dx = 1.15;
      let dy = 0.85;
      let x = 24;
      let y = 24;
      let rafId = 0;

      const tick = () => {
        if (miniDvd && miniDvd.parentElement) {
          const pw = miniDvd.parentElement.clientWidth;
          const ph = miniDvd.parentElement.clientHeight;
          const cw = miniDvd.offsetWidth || 68;
          const ch = miniDvd.offsetHeight || 34;

          x += dx;
          y += dy;
          let hit = false;
          if (x <= 10 || x + cw >= pw - 10) {
            dx = -dx;
            x = Math.max(10, Math.min(pw - cw - 10, x));
            hit = true;
          }
          if (y <= 10 || y + ch >= ph - 10) {
            dy = -dy;
            y = Math.max(10, Math.min(ph - ch - 10, y));
            hit = true;
          }
          if (hit) {
            colorIdx = (colorIdx + 1) % colors.length;
            const c = colors[colorIdx];
            miniDvd.style.borderColor = c;
            miniDvd.style.color = c;
            miniDvd.style.boxShadow = `0 0 24px ${c}55`;
          }
          miniDvd.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        }

        if (miniHour && miniMin && miniSec) {
          const now = new Date();
          const sec = now.getSeconds() + now.getMilliseconds() / 1000;
          const min = now.getMinutes() + sec / 60;
          const hr = (now.getHours() % 12) + min / 60;
          miniSec.setAttribute('transform', `rotate(${sec * 6} 60 60)`);
          miniMin.setAttribute('transform', `rotate(${min * 6} 60 60)`);
          miniHour.setAttribute('transform', `rotate(${hr * 30} 60 60)`);
        }

        rafId = requestAnimationFrame(tick);
      };

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        rafId = requestAnimationFrame(tick);
      }

      galleryCleanup = () => cancelAnimationFrame(rafId);
    }

    document.addEventListener('astro:page-load', initGallery);
    document.addEventListener('astro:before-swap', () => {
      galleryCleanup?.();
      galleryCleanup = null;
    });
    initGallery();
  </script>
</BaseLayout>
