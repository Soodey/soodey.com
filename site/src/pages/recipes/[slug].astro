---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../../styles/global.css';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const r = entry.data;
const totalSteps = r.parts.reduce((acc, part) => acc + part.steps.length, 0);

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Recipe',
  name: r.title,
  description: r.description,
  image: [`https://soodey.com${r.image.src}`],
  author: { '@type': 'Person', name: r.author },
  datePublished: r.datePublished,
  prepTime: r.prepTimeISO,
  cookTime: r.cookTimeISO,
  totalTime: r.totalTimeISO,
  recipeYield: r.yield,
  recipeCategory: r.category,
  recipeCuisine: r.cuisine,
  keywords: r.keywords,
  recipeIngredient: r.ingredients.map((i) => i.schemaText),
  recipeInstructions: r.parts.map((part) => ({
    '@type': 'HowToSection',
    name: `${part.pill}: ${part.title}`,
    itemListElement: part.steps.map((step) => ({
      '@type': 'HowToStep',
      name: step.title,
      text: step.schemaText,
    })),
  })),
};
---

<!DOCTYPE html>
<html lang="en" style="background-color:#f5efe6; color:#1f1916; color-scheme:light;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{r.title} — Soodey.com</title>
  <meta name="description" content={r.description} />
  <link rel="canonical" href={`https://soodey.com/recipes/${entry.id}/`} />
  <meta name="theme-color" content="#9e3b1d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Soodey's Kitchen" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={r.title} />
  <meta property="og:description" content={r.description} />
  <meta property="og:url" content={`https://soodey.com/recipes/${entry.id}/`} />
  <meta property="og:image" content={`https://soodey.com${r.image.src}`} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content={String(r.image.width)} />
  <meta property="og:image:height" content={String(r.image.height)} />
  <meta property="og:image:alt" content={r.image.alt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={r.title} />
  <meta name="twitter:description" content={r.description} />
  <meta name="twitter:image" content={`https://soodey.com${r.image.src}`} />
  <meta name="twitter:image:alt" content={r.image.alt} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <ClientRouter />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    .ingredient-item.is-checked .ingredient-label { opacity: 0.5; }
    .ingredient-item.is-checked .ingredient-main { text-decoration: line-through; text-decoration-color: #82766a; }
    .step-card.is-done { opacity: 0.56; background: #f7f2ea; }
    .step-card.is-done .step-num { background: #3e6b48; border-color: #3e6b48; color: #fffdf9; font-size: 0; }
    .step-card.is-done .step-num::after { content: "✓"; font-size: 0.95rem; font-weight: 800; }
    .step-card.is-done .step-title { text-decoration: line-through; text-decoration-color: #82766a; }
    .step-tip { color: #5a5047; font-style: italic; }
    .qty-secondary { color: #5a5047; font-weight: 600; }

    .unit-btn[aria-pressed="true"] {
      background: #fffdf9;
      color: #9e3b1d;
      box-shadow: 0 1px 3px rgba(31, 25, 22, 0.1);
    }
    #wakeLockBtn[aria-pressed="true"] {
      background: #9e3b1d;
      border-color: #9e3b1d;
      color: #fffdf9;
    }
    #wakeLockBtn[aria-pressed="true"] .wake-dot {
      background: #ffd166;
      box-shadow: 0 0 0 3px rgba(255, 209, 102, 0.35);
    }

    @media print {
      @page { margin: 0.55in; }
      html, body { background: #ffffff !important; color: #111111 !important; font-size: 10.5pt; }
      .no-print { display: none !important; }
      .recipe-shell { border: none !important; box-shadow: none !important; border-radius: 0 !important; background: #ffffff !important; }
      .step-card, .ingredient-item { opacity: 1 !important; break-inside: avoid; }
      .step-card.is-done .step-title, .ingredient-item.is-checked .ingredient-main { text-decoration: none !important; }
    }
  </style>
</head>
<body class="bg-[#f5efe6] text-[#1f1916] antialiased min-h-screen" style="font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;">
  <nav class="no-print max-w-[1080px] mx-auto px-5 pt-5 pb-3 flex items-center justify-between gap-4 text-sm" aria-label="Site navigation">
    <a class="inline-flex items-center gap-2.5 text-[#1f1916] hover:text-[#9e3b1d] transition font-serif text-xl font-semibold tracking-[-0.01em]" href="/recipes/">
      <span class="w-2 h-2 rounded-full bg-[#9e3b1d] shrink-0" aria-hidden="true"></span>
      <span>Soodey’s Kitchen</span>
    </a>
    <div class="flex items-center gap-5">
      <a class="text-[#5a5047] hover:text-[#9e3b1d] font-medium transition" href="/recipes/">← All Recipes</a>
      <a class="text-[#5a5047] hover:text-[#9e3b1d] font-medium transition" href="/gallery/">Gallery</a>
    </div>
  </nav>

  <main class="max-w-[1080px] mx-auto px-3 sm:px-5 pt-2 pb-16">
    <article
      class="recipe-shell bg-[#fffdf9] border border-[#e4dacb] rounded-[18px] shadow-[0_1px_2px_rgba(31,25,22,0.04),0_14px_36px_rgba(31,25,22,0.06)] overflow-hidden animate-rise"
      data-recipe-id={entry.id}
    >
      <!-- Header -->
      <header class="p-6 sm:p-10 pb-7 border-b border-[#e4dacb] space-y-5">
        <div>
          <div class="text-xs font-bold uppercase tracking-[0.11em] text-[#9e3b1d] mb-2.5">
            {r.eyebrow}
          </div>
          <h1 class="font-serif text-3xl sm:text-5xl font-semibold leading-[1.08] tracking-[-0.022em] text-[#1f1916] m-0 mb-3">
            {r.title}
          </h1>
          <p class="font-serif italic text-lg text-[#5a5047] leading-relaxed max-w-[72ch] m-0">
            {r.subtitle}
          </p>
        </div>

        <!-- Meta Strip -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 sm:px-5 rounded-xl bg-[#f7f2ea] border border-[#e4dacb] m-0">
          <div class="sm:border-r sm:border-[#e4dacb] sm:pr-3">
            <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#82766a]">Prep Time</dt>
            <dd class="text-base font-bold text-[#1f1916] mt-0.5 tabular-nums m-0">{r.prepTime}</dd>
          </div>
          <div class="sm:border-r sm:border-[#e4dacb] sm:pr-3">
            <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#82766a]">Cook &amp; Bake</dt>
            <dd class="text-base font-bold text-[#1f1916] mt-0.5 tabular-nums m-0">{r.cookTime}</dd>
          </div>
          <div class="sm:border-r sm:border-[#e4dacb] sm:pr-3">
            <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#82766a]">Yield</dt>
            <dd class="text-base font-bold text-[#1f1916] mt-0.5 tabular-nums m-0">{r.yield}</dd>
          </div>
          {r.bakingDish && (
            <div>
              <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#82766a]">Baking Dish</dt>
              <dd class="text-base font-bold text-[#1f1916] mt-0.5 tabular-nums m-0">{r.bakingDish}</dd>
            </div>
          )}
        </dl>

        <!-- Utility Toolbar -->
        <div class="no-print flex flex-wrap items-center justify-between gap-3">
          <div class="inline-flex items-center p-[3px] rounded-full bg-[#f7f2ea] border border-[#e4dacb] gap-0.5" role="group" aria-label="Measurement display units">
            <button type="button" class="unit-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#5a5047] hover:text-[#1f1916] cursor-pointer transition" data-unit-mode="both" aria-pressed="true">Both (g + US)</button>
            <button type="button" class="unit-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#5a5047] hover:text-[#1f1916] cursor-pointer transition" data-unit-mode="metric" aria-pressed="false">Metric (g)</button>
            <button type="button" class="unit-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#5a5047] hover:text-[#1f1916] cursor-pointer transition" data-unit-mode="us" aria-pressed="false">US Volume</button>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="wakeLockBtn"
              aria-pressed="false"
              title="Prevent your screen from dimming while cooking"
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#fffdf9] border border-[#d3c5b1] hover:border-[#9e3b1d] hover:text-[#9e3b1d] hover:bg-[#f9ece5] text-xs font-semibold text-[#1f1916] cursor-pointer transition"
            >
              <span class="wake-dot w-2 h-2 rounded-full bg-[#d3c5b1] transition"></span>
              <span id="wakeLockLabel">Screen Awake</span>
            </button>
            <button
              type="button"
              id="printBtn"
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#fffdf9] border border-[#d3c5b1] hover:border-[#9e3b1d] hover:text-[#9e3b1d] hover:bg-[#f9ece5] text-xs font-semibold text-[#1f1916] cursor-pointer transition"
            >
              <span>Print Recipe</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Hero Photo -->
      <figure class="m-0 bg-[#e9dfd1] border-b border-[#e4dacb]">
        <img src={r.image.src} alt={r.image.alt} class="w-full max-h-[490px] object-cover block" />
        <figcaption class="no-print px-6 sm:px-10 py-2.5 bg-[#f7f2ea] text-xs text-[#82766a]">
          {r.image.caption}
        </figcaption>
      </figure>

      <!-- Two-Column Recipe Body -->
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(290px,370px)_minmax(0,1fr)] items-start">
        <!-- Ingredients -->
        <aside class="p-6 sm:p-8 lg:pl-10 lg:border-r border-b lg:border-b-0 border-[#e4dacb] lg:sticky lg:top-4 bg-gradient-to-b from-[#f7f2ea]/50 to-transparent">
          <div class="flex items-baseline justify-between gap-3 pb-3 mb-4 border-b-2 border-[#9e3b1d]">
            <h2 class="text-xs font-extrabold uppercase tracking-[0.11em] text-[#9e3b1d] m-0">Ingredients</h2>
            <div class="no-print inline-flex items-center gap-2 text-xs text-[#82766a] tabular-nums">
              <span id="ingredientCounter">0 / {r.ingredients.length}</span>
              <button type="button" id="resetIngredientsBtn" hidden class="text-[#9e3b1d] font-semibold underline bg-transparent border-0 p-0 text-xs cursor-pointer">Reset</button>
            </div>
          </div>

          <ul class="list-none p-0 m-0 divide-y divide-[#e4dacb]">
            {r.ingredients.map((ing) => (
              <li class="ingredient-item" data-id={ing.id}>
                <label class="ingredient-label flex items-start gap-3 py-2.5 px-1.5 -mx-1.5 rounded-md hover:bg-[#f7f2ea] cursor-pointer select-none transition">
                  <input
                    type="checkbox"
                    class="ingredient-checkbox mt-0.5 w-4 h-4 accent-[#9e3b1d] cursor-pointer shrink-0"
                  />
                  <span class="flex flex-col gap-0.5 min-w-0">
                    <span class="ingredient-main text-[0.95rem] leading-snug text-[#1f1916]">
                      <span
                        class="ingredient-qty font-bold text-[#1f1916] tabular-nums"
                        data-metric={ing.metric}
                        data-us={ing.us}
                        data-both-primary={ing.bothPrimary}
                        data-both-secondary={ing.bothSecondary}
                      >
                        {ing.bothPrimary ?? ing.metric}{' '}
                        <span class="qty-secondary">{ing.bothSecondary ?? `(${ing.us})`}</span>
                      </span>{' '}
                      {ing.name}
                      {ing.dayTag && (
                        <span class="ml-1 px-2 py-0.5 rounded-full bg-[#f9ece5] text-[#9e3b1d] text-[10px] font-bold uppercase tracking-wider align-middle">
                          {ing.dayTag}
                        </span>
                      )}
                    </span>
                    {ing.note && <span class="text-xs italic text-[#5a5047]">{ing.note}</span>}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Instructions -->
        <section class="p-6 sm:p-9 lg:pr-10 space-y-8">
          <div class="flex items-baseline justify-between gap-3 pb-3 border-b-2 border-[#9e3b1d]">
            <h2 class="text-xs font-extrabold uppercase tracking-[0.11em] text-[#9e3b1d] m-0">Step-by-Step Instructions</h2>
            <div class="no-print inline-flex items-center gap-2 text-xs text-[#82766a] tabular-nums">
              <span id="stepCounter">0 / {totalSteps} done</span>
              <button type="button" id="resetStepsBtn" hidden class="text-[#9e3b1d] font-semibold underline bg-transparent border-0 p-0 text-xs cursor-pointer">Reset</button>
            </div>
          </div>

          {r.parts.map((part, pIdx) => (
            <div class:list={['space-y-4', pIdx > 0 && 'pt-7 border-t border-dashed border-[#d3c5b1]']}>
              <h3 class="flex flex-wrap items-center gap-2.5 font-serif text-xl sm:text-2xl font-semibold text-[#1f1916] m-0">
                <span class="px-2.5 py-0.5 rounded-full bg-[#f9ece5] text-[#9e3b1d] font-sans text-[11px] font-bold uppercase tracking-wider">
                  {part.pill}
                </span>
                <span>{part.title}</span>
              </h3>

              <ol class="list-none p-0 m-0 space-y-3.5">
                {part.steps.map((step, sIdx) => (
                  <li
                    class="step-card grid grid-cols-[34px_minmax(0,1fr)] gap-3.5 p-4 rounded-xl border border-[#e4dacb] bg-[#fffdf9] hover:border-[#d3c5b1] hover:bg-[#fffaf3] cursor-pointer transition"
                    data-step-id={step.id}
                    tabindex="0"
                    role="checkbox"
                    aria-checked="false"
                  >
                    <div class="step-num w-8 h-8 rounded-full bg-[#f9ece5] border border-[#9e3b1d]/25 text-[#9e3b1d] flex items-center justify-center text-sm font-extrabold tabular-nums shrink-0 transition">
                      {sIdx + 1}
                    </div>
                    <div class="space-y-1.5">
                      <h4 class="step-title text-base font-bold text-[#1f1916] m-0 leading-snug">{step.title}</h4>
                      <ul class="m-0 pl-4 space-y-1.5 text-[0.95rem] text-[#1f1916] leading-relaxed marker:text-[#9e3b1d]">
                        {step.bullets.map((b) => (
                          <li set:html={b} />
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}

          <p class="no-print text-xs text-[#82766a] m-0">
            Tip: Tap any step to check it off as you cook — progress saves automatically on this device.
          </p>
        </section>
      </div>

      <footer class="px-6 sm:px-10 py-4 bg-[#f7f2ea] border-t border-[#e4dacb] flex flex-wrap items-center justify-between gap-2 text-xs text-[#82766a]">
        <span>{r.title}</span>
        <span>soodey.com/recipes</span>
      </footer>
    </article>
  </main>

  <script>
    function initRecipeCard() {
      const card = document.querySelector('.recipe-shell') as HTMLElement | null;
      if (!card) return;

      const recipeId = card.dataset.recipeId || 'recipe';
      const STORAGE_PREFIX = `soodey-recipe:${recipeId}:`;

      const loadState = <T,>(key: string, fallback: T): T => {
        try {
          const raw = localStorage.getItem(STORAGE_PREFIX + key);
          return raw ? JSON.parse(raw) : fallback;
        } catch {
          return fallback;
        }
      };

      const saveState = (key: string, value: unknown) => {
        try {
          localStorage.setItem(STORAGE_PREFIX + key, JSON.stringify(value));
        } catch {}
      };

      const unitBtns = Array.from(document.querySelectorAll('.unit-btn')) as HTMLButtonElement[];
      const qtyEls = Array.from(document.querySelectorAll('.ingredient-qty')) as HTMLElement[];

      function applyUnitMode(mode: string) {
        unitBtns.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.unitMode === mode)));
        qtyEls.forEach((el) => {
          const metric = el.dataset.metric || '';
          const us = el.dataset.us || '';
          const bothPrimary = el.dataset.bothPrimary || metric;
          const bothSecondary = el.dataset.bothSecondary || `(${us})`;
          const inIngredients = Boolean(el.closest('.ingredient-item'));

          if (mode === 'metric') el.textContent = metric;
          else if (mode === 'us') el.textContent = us;
          else if (inIngredients) el.innerHTML = `${bothPrimary} <span class="qty-secondary">${bothSecondary}</span>`;
          else el.textContent = `${bothPrimary} ${bothSecondary}`;
        });
        saveState('unitMode', mode);
      }

      applyUnitMode(loadState('unitMode', 'both'));
      unitBtns.forEach((btn) => btn.addEventListener('click', () => applyUnitMode(btn.dataset.unitMode || 'both')));

      const ingredientItems = Array.from(document.querySelectorAll('.ingredient-item')) as HTMLElement[];
      const ingredientCounter = document.getElementById('ingredientCounter');
      const resetIngredientsBtn = document.getElementById('resetIngredientsBtn') as HTMLButtonElement | null;
      const checkedIngredients = new Set<string>(loadState<string[]>('ingredients', []));

      function renderIngredients() {
        let count = 0;
        ingredientItems.forEach((item) => {
          const id = item.dataset.id || '';
          const cb = item.querySelector('.ingredient-checkbox') as HTMLInputElement | null;
          const isChecked = checkedIngredients.has(id);
          if (cb) cb.checked = isChecked;
          item.classList.toggle('is-checked', isChecked);
          if (isChecked) count++;
        });
        if (ingredientCounter) ingredientCounter.textContent = `${count} / ${ingredientItems.length}`;
        if (resetIngredientsBtn) resetIngredientsBtn.hidden = count === 0;
      }

      ingredientItems.forEach((item) => {
        const cb = item.querySelector('.ingredient-checkbox') as HTMLInputElement | null;
        cb?.addEventListener('change', () => {
          const id = item.dataset.id || '';
          if (cb.checked) checkedIngredients.add(id);
          else checkedIngredients.delete(id);
          saveState('ingredients', Array.from(checkedIngredients));
          renderIngredients();
        });
      });

      resetIngredientsBtn?.addEventListener('click', () => {
        checkedIngredients.clear();
        saveState('ingredients', []);
        renderIngredients();
      });

      const stepCards = Array.from(document.querySelectorAll('.step-card')) as HTMLElement[];
      const stepCounter = document.getElementById('stepCounter');
      const resetStepsBtn = document.getElementById('resetStepsBtn') as HTMLButtonElement | null;
      const doneSteps = new Set<string>(loadState<string[]>('steps', []));

      function renderSteps() {
        let count = 0;
        stepCards.forEach((step) => {
          const id = step.dataset.stepId || '';
          const isDone = doneSteps.has(id);
          step.classList.toggle('is-done', isDone);
          step.setAttribute('aria-checked', String(isDone));
          if (isDone) count++;
        });
        if (stepCounter) stepCounter.textContent = `${count} / ${stepCards.length} done`;
        if (resetStepsBtn) resetStepsBtn.hidden = count === 0;
      }

      function toggleStep(step: HTMLElement) {
        const id = step.dataset.stepId || '';
        if (doneSteps.has(id)) doneSteps.delete(id);
        else doneSteps.add(id);
        saveState('steps', Array.from(doneSteps));
        renderSteps();
      }

      stepCards.forEach((step) => {
        step.addEventListener('click', () => {
          if (window.getSelection && window.getSelection()?.toString().trim()) return;
          toggleStep(step);
        });
        step.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            toggleStep(step);
          }
        });
      });

      resetStepsBtn?.addEventListener('click', () => {
        doneSteps.clear();
        saveState('steps', []);
        renderSteps();
      });

      renderIngredients();
      renderSteps();

      // Wake Lock Cook Mode
      const wakeLockBtn = document.getElementById('wakeLockBtn') as HTMLButtonElement | null;
      const wakeLockLabel = document.getElementById('wakeLockLabel');
      let wakeLockSentinel: WakeLockSentinel | null = null;
      let wakeLockDesired = false;

      async function requestWakeLock() {
        try {
          wakeLockSentinel = await navigator.wakeLock.request('screen');
          wakeLockBtn?.setAttribute('aria-pressed', 'true');
          if (wakeLockLabel) wakeLockLabel.textContent = 'Screen Awake: On';
          wakeLockSentinel.addEventListener('release', () => {
            if (!wakeLockDesired) {
              wakeLockBtn?.setAttribute('aria-pressed', 'false');
              if (wakeLockLabel) wakeLockLabel.textContent = 'Screen Awake';
            }
          });
        } catch {
          wakeLockDesired = false;
          wakeLockBtn?.setAttribute('aria-pressed', 'false');
          if (wakeLockLabel) wakeLockLabel.textContent = 'Screen Awake';
        }
      }

      wakeLockBtn?.addEventListener('click', async () => {
        if (!('wakeLock' in navigator)) {
          if (wakeLockLabel) wakeLockLabel.textContent = 'Not Supported';
          setTimeout(() => { if (wakeLockLabel) wakeLockLabel.textContent = 'Screen Awake'; }, 1800);
          return;
        }
        if (wakeLockDesired) {
          wakeLockDesired = false;
          if (wakeLockSentinel) {
            await wakeLockSentinel.release();
            wakeLockSentinel = null;
          }
          wakeLockBtn.setAttribute('aria-pressed', 'false');
          if (wakeLockLabel) wakeLockLabel.textContent = 'Screen Awake';
        } else {
          wakeLockDesired = true;
          await requestWakeLock();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (wakeLockDesired && document.visibilityState === 'visible') requestWakeLock();
      });

      document.getElementById('printBtn')?.addEventListener('click', () => window.print());
    }

    document.addEventListener('astro:page-load', initRecipeCard);
    initRecipeCard();
  </script>
</body>
</html>
