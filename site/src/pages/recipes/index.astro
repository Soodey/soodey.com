---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../../styles/global.css';

const recipes = (await getCollection('recipes')).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);
const leadImage = recipes[0]?.data.image;
---

<!DOCTYPE html>
<html lang="en" style="background-color:#f5efe6; color:#1f1916; color-scheme:light;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipes — Soodey.com</title>
  <meta name="description" content="Clean, tested recipes without the 2,000-word life story. Straight to ingredients, weights, and steps." />
  <link rel="canonical" href="https://soodey.com/recipes/" />
  <meta name="theme-color" content="#9e3b1d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Soodey's Kitchen" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="Soodey's Kitchen — Recipes Without the Clutter" />
  <meta property="og:description" content="Clean, tested recipes without the 2,000-word life story. Straight to ingredients, weights, and steps." />
  <meta property="og:url" content="https://soodey.com/recipes/" />
  {leadImage && <meta property="og:image" content={`https://soodey.com${leadImage.src}`} />}
  {leadImage && <meta property="og:image:width" content={String(leadImage.width)} />}
  {leadImage && <meta property="og:image:height" content={String(leadImage.height)} />}
  {leadImage && <meta property="og:image:alt" content={leadImage.alt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Soodey's Kitchen — Recipes Without the Clutter" />
  <meta name="twitter:description" content="Clean, tested recipes without the 2,000-word life story. Straight to ingredients, weights, and steps." />
  {leadImage && <meta name="twitter:image" content={`https://soodey.com${leadImage.src}`} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <ClientRouter />
</head>
<body class="bg-[#f5efe6] text-[#1f1916] antialiased min-h-screen" style="font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;">
  <nav class="max-w-[1080px] mx-auto px-5 pt-5 pb-3 flex items-center justify-between gap-4 text-sm" aria-label="Site navigation">
    <a class="inline-flex items-center gap-2.5 text-[#1f1916] hover:text-[#9e3b1d] transition font-serif text-xl font-semibold tracking-[-0.01em]" href="/recipes/">
      <span class="w-2 h-2 rounded-full bg-[#9e3b1d] shrink-0" aria-hidden="true"></span>
      <span>Soodey’s Kitchen</span>
    </a>
    <div class="flex items-center gap-5">
      <a class="text-[#9e3b1d] font-medium" href="/recipes/">Recipes</a>
      <a class="text-[#5a5047] hover:text-[#9e3b1d] font-medium transition" href="/gallery/">Gallery</a>
      <a class="text-[#5a5047] hover:text-[#9e3b1d] font-medium transition" href="/">soodey.com</a>
    </div>
  </nav>

  <main class="max-w-[1080px] mx-auto px-5 pt-3 pb-16">
    <header class="py-7 border-b border-[#e4dacb] mb-8 animate-rise">
      <div class="text-xs font-bold uppercase tracking-[0.11em] text-[#9e3b1d] mb-2.5">
        Tested Recipes · Zero Blog Clutter
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.1] tracking-[-0.02em] text-[#1f1916] m-0 mb-2.5">
        Recipes
      </h1>
      <p class="text-[#5a5047] text-base sm:text-[1.05rem] max-w-[600px] m-0 leading-relaxed">
        No life stories, no popups, no jump-to-recipe button needed. Just dialed-in weights, clear steps, and kitchen-friendly recipe cards.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7" aria-label="Recipe collection">
      {recipes.map((entry) => {
        const r = entry.data;
        return (
          <a
            href={`/recipes/${entry.id}/`}
            class="group flex flex-col bg-[#fffdf9] border border-[#e4dacb] hover:border-[#d3c5b1] rounded-[18px] overflow-hidden shadow-[0_1px_2px_rgba(31,25,22,0.04),0_14px_36px_rgba(31,25,22,0.06)] hover:shadow-[0_4px_12px_rgba(31,25,22,0.07),0_18px_40px_rgba(31,25,22,0.09)] hover:-translate-y-0.5 transition duration-200 animate-rise"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-[#e9dfd1]">
              <img
                src={r.image.src}
                alt={r.image.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="eager"
              />
              <span class="absolute top-3.5 left-3.5 bg-[#fffdf9]/95 text-[#9e3b1d] text-[11px] font-bold tracking-[0.08em] uppercase px-2.5 py-1 rounded-full border border-[#9e3b1d]/20 backdrop-blur-sm">
                {r.category}
              </span>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-serif text-2xl font-semibold leading-[1.2] tracking-[-0.015em] text-[#1f1916] m-0 mb-2">
                {r.title}
              </h2>
              <p class="text-sm text-[#5a5047] leading-relaxed m-0 mb-5 flex-1">
                {r.subtitle}
              </p>
              <div class="flex flex-wrap gap-x-4 gap-y-2 pt-3.5 border-t border-[#e4dacb] text-xs text-[#82766a] font-medium">
                <span>Prep: {r.prepTime}</span>
                <span>Cook: {r.cookTime}</span>
                <span>{r.yieldShort}</span>
                <span class="text-[#9e3b1d] font-bold ml-auto">Open Card →</span>
              </div>
            </div>
          </a>
        );
      })}
    </section>
  </main>
</body>
</html>
